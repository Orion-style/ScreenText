<UserControl x:Class="ZenithApp.Modules.StickyNotes.StickyNotesSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="600">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <StackPanel>
        <!-- Быстрые действия -->
        <ui:Card Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Стикеры на рабочем столе" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SummaryText}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="{Binding ToggleAllButtonText}"
                               Command="{Binding ToggleAllVisibilityCommand}"
                               IsEnabled="{Binding HasNotes}"
                               Margin="0,0,8,0" />
                    <ui:Button Content="Новый стикер"
                               Appearance="Primary"
                               Icon="{ui:SymbolIcon NoteAdd24}"
                               Command="{Binding CreateNoteCommand}" />
                </StackPanel>
            </Grid>
        </ui:Card>

        <!-- Горячие клавиши -->
        <ui:Card Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Горячие клавиши" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,12" />

                <!-- Создать стикер -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Создать новый стикер" FontWeight="Medium" TextWrapping="Wrap" />
                        <TextBlock Text="Кликните на поле справа и нажмите желаемую комбинацию"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   FontSize="12"
                                   Margin="0,2,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:TextBox Grid.Column="1"
                                Width="170"
                                IsReadOnly="True"
                                Text="{Binding CreateHotkeyText, Mode=OneWay}"
                                TextAlignment="Center"
                                FontWeight="SemiBold"
                                PreviewKeyDown="OnCreateHotkeyPreviewKeyDown" />
                </Grid>

                <TextBlock Text="{Binding CreateConflictMessage}"
                           Foreground="#EF4444"
                           FontSize="12"
                           Margin="0,0,0,10"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasCreateConflict, Converter={StaticResource BoolToVis}}" />

                <!-- Показать / скрыть все -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Показать / скрыть все стикеры" FontWeight="Medium" TextWrapping="Wrap" />
                        <TextBlock Text="Быстро убирает и возвращает все стикеры с экрана"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   FontSize="12"
                                   Margin="0,2,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:TextBox Grid.Column="1"
                                Width="170"
                                IsReadOnly="True"
                                Text="{Binding ToggleVisibilityHotkeyText, Mode=OneWay}"
                                TextAlignment="Center"
                                FontWeight="SemiBold"
                                PreviewKeyDown="OnToggleHotkeyPreviewKeyDown" />
                </Grid>

                <TextBlock Text="{Binding ToggleConflictMessage}"
                           Foreground="#EF4444"
                           FontSize="12"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasToggleConflict, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </ui:Card>

        <!-- Параметры новых стикеров по умолчанию -->
        <ui:Card Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Вид новых стикеров по умолчанию" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,12" />

                <!-- Цвет -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Цвет фона" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding ColorPresets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="26"
                                        Height="26"
                                        Margin="4,0,0,0"
                                        ToolTip="{Binding Name}"
                                        Background="{Binding BackgroundBrush}"
                                        BorderBrush="{Binding BorderBrush}"
                                        BorderThickness="1.5"
                                        Cursor="Hand"
                                        Command="{Binding DataContext.SelectDefaultColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding ColorHex}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <!-- Прозрачность -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Непрозрачность" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Slider Minimum="35" Maximum="100" Value="{Binding DefaultOpacityPercent, Mode=TwoWay}" Width="140" Margin="0,0,10,0" TickFrequency="5" IsSnapToTickEnabled="True" />
                        <TextBlock Text="{Binding DefaultOpacityText}" MinWidth="46" TextAlignment="Right" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- Размер шрифта -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Размер шрифта" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Slider Minimum="10" Maximum="28" Value="{Binding DefaultFontSize, Mode=TwoWay}" Width="140" Margin="0,0,10,0" TickFrequency="1" IsSnapToTickEnabled="True" />
                        <TextBlock Text="{Binding DefaultFontSizeText}" MinWidth="46" TextAlignment="Right" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- Поверх окон -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Закреплять поверх всех приложений" VerticalAlignment="Center" Margin="0,0,16,0" TextWrapping="Wrap" />
                    <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding DefaultTopmost, Mode=TwoWay}" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </ui:Card>

        <!-- Список сохранённых стикеров -->
        <ui:Card Padding="16">
            <StackPanel>
                <TextBlock Text="Сохранённые стикеры" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,4" />
                <TextBlock Text="Стикеры автоматически восстанавливаются после перезагрузки ПК (если включён автозапуск Zenith)"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           FontSize="12"
                           Margin="0,0,0,12"
                           TextWrapping="Wrap" />

                <TextBlock Text="Список пуст."
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Visibility="{Binding HasNoNotes, Converter={StaticResource BoolToVis}}" />

                <ItemsControl ItemsSource="{Binding Notes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="6"
                                    Padding="10,8"
                                    Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Width="4"
                                            CornerRadius="2"
                                            Background="{Binding AccentBrush}"
                                            Margin="0,2,10,2" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding PreviewText}"
                                                   FontWeight="Medium"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding StatusBadgeText}"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:Button Content="{Binding ToggleVisibilityText}"
                                                   Padding="8,4"
                                                   Margin="0,0,4,0"
                                                   Command="{Binding DataContext.ToggleNoteVisibilityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}" />
                                        <ui:Button Content="{Binding ToggleClickThroughText}"
                                                   Padding="8,4"
                                                   Margin="0,0,4,0"
                                                   Command="{Binding DataContext.ToggleNoteClickThroughCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}" />
                                        <ui:Button Padding="6,4"
                                                   Margin="0,0,4,0"
                                                   Icon="{ui:SymbolIcon MyLocation16}"
                                                   ToolTip="Вернуть в видимую область экрана"
                                                   Command="{Binding DataContext.CenterNoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}" />
                                        <ui:Button Padding="6,4"
                                                   Icon="{ui:SymbolIcon Delete16}"
                                                   ToolTip="Удалить стикер"
                                                   Command="{Binding DataContext.DeleteNoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ui:Card>
    </StackPanel>
</UserControl>
