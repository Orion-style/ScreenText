<Window x:Class="ZenithApp.Modules.StickyNotes.StickyNoteHeaderOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        Height="30">
    <Window.Resources>
        <Style x:Key="HeaderActionBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#28FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#44FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder"
            CornerRadius="8,8,0,0"
            BorderThickness="1,1,1,1"
            Padding="8,0,4,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Зона перетаскивания и индикатор сквозного режима -->
            <Grid Grid.Column="0"
                  Background="Transparent"
                  Cursor="SizeAll"
                  MouseLeftButtonDown="OnDragMouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="LockClosed16"
                                   FontSize="12"
                                   Margin="0,0,5,0"
                                   Foreground="{Binding ElementName=TxtBadge, Path=Foreground}" />
                    <TextBlock x:Name="TxtBadge"
                               Text="Сквозь клики"
                               FontSize="11"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>

            <!-- Обычная панель кнопок -->
            <StackPanel x:Name="NormalActionsPanel"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button Style="{StaticResource HeaderActionBtnStyle}"
                        ToolTip="Вернуть обычный режим (отключить пропуск кликов)"
                        Click="OnUnlockClick">
                    <ui:SymbolIcon x:Name="IconUnlock" Symbol="LockOpen16" FontSize="13" />
                </Button>
                <Button Style="{StaticResource HeaderActionBtnStyle}"
                        ToolTip="Свернуть / развернуть"
                        Click="OnCollapseClick">
                    <ui:SymbolIcon x:Name="IconCollapse" Symbol="ChevronUp16" FontSize="13" />
                </Button>
                <Button Style="{StaticResource HeaderActionBtnStyle}"
                        ToolTip="Удалить стикер"
                        Click="OnDeleteClick">
                    <ui:SymbolIcon x:Name="IconDelete" Symbol="Delete16" FontSize="13" />
                </Button>
            </StackPanel>

            <!-- Компактное подтверждение удаления внутри менюшки -->
            <StackPanel x:Name="ConfirmDeletePanel"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                <TextBlock x:Name="TxtConfirm"
                           Text="Удалить?"
                           FontSize="11"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,4,0" />
                <Button Content="Да"
                        Height="22"
                        Padding="7,0"
                        Margin="0,0,2,0"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Background="#DC2626"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="OnConfirmDeleteYesClick" />
                <Button Content="Нет"
                        Height="22"
                        Padding="6,0"
                        FontSize="11"
                        Foreground="White"
                        Background="#3F4654"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="OnConfirmDeleteNoClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
