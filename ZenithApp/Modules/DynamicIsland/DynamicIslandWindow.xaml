<Window x:Class="ZenithApp.Modules.DynamicIsland.DynamicIslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        AllowDrop="True"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        PreviewDragEnter="OnWindowDragEnter"
        PreviewDragOver="OnWindowDragOver"
        PreviewDragLeave="OnWindowDragLeave"
        PreviewDrop="OnWindowDrop"
        MouseEnter="OnWindowMouseEnter"
        MouseLeave="OnWindowMouseLeave">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="IslandIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1AFFFFFF" />
            <Setter Property="Foreground" Value="#F3F4F6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#48FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IslandRoundIconButtonStyle" TargetType="Button" BasedOn="{StaticResource IslandIconButtonStyle}">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="13">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#48FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IslandAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource IslandIconButtonStyle}">
            <Setter Property="Background" Value="#3B82F6" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#2563EB" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#1D4ED8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Небольшое прозрачное поле для тени (Background=null вокруг, чтобы не перехватывать клики) -->
    <Grid Margin="10,2,10,12">
        <Border x:Name="PillBorder"
                Width="164"
                MinHeight="30"
                CornerRadius="15"
                Background="#F2101116"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                ClipToBounds="True"
                SnapsToDevicePixels="True"
                MouseLeftButtonUp="OnPillMouseLeftButtonUp">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" Opacity="0.45" ShadowDepth="2" Color="#000000" />
            </Border.Effect>

            <Grid x:Name="ContentHost">
                <!-- 1. Тонкий режим (AutoHideWhenIdle) -->
                <Grid x:Name="ViewHiddenNotch" Visibility="Collapsed" Height="7">
                    <Border Background="#66FFFFFF" CornerRadius="2" Width="44" Height="3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>

                <!-- 2. Компактная пилюля покоя -->
                <Grid x:Name="ViewCompactIdle"
                      Visibility="Visible"
                      Height="30"
                      Margin="11,0"
                      Cursor="Hand">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Индикатор статуса (музыка / полка / точка) -->
                    <Border x:Name="CompactStatusDot"
                            Grid.Column="0"
                            Width="8" Height="8"
                            CornerRadius="4"
                            Background="#3B82F6"
                            VerticalAlignment="Center"
                            Margin="0,0,7,0" />

                    <TextBlock x:Name="TxtCompactStatus"
                               Grid.Column="1"
                               Text="Zenith"
                               Foreground="#E5E7EB"
                               FontSize="11.5"
                               FontWeight="Medium"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />

                    <!-- Бейдж полки -->
                    <Border x:Name="CompactShelfBadge"
                            Grid.Column="2"
                            Background="#24FFFFFF"
                            CornerRadius="8"
                            Padding="6,1"
                            Margin="7,0,0,0"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                        <TextBlock x:Name="TxtCompactShelfCount"
                                   Text="0"
                                   Foreground="#93C5FD"
                                   FontSize="10.5"
                                   FontWeight="SemiBold" />
                    </Border>
                </Grid>

                <!-- 3. Зона сброса (DragOver) -->
                <Border x:Name="ViewDropTarget"
                        Visibility="Collapsed"
                        Margin="10"
                        Padding="14,12"
                        CornerRadius="14"
                        Background="#1A3B82F6"
                        BorderBrush="#8860A5FA"
                        BorderThickness="1.5">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="⬇  Отпустите, чтобы сохранить в островок"
                                   Foreground="#EFF6FF"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Файлы, папки, ссылки или выделенный текст"
                                   Foreground="#BFDBFE"
                                   FontSize="11"
                                   Margin="0,3,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- 4. Уведомление приложения -->
                <Grid x:Name="ViewNotification" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="3" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="14,11,12,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="NotifIconBadge"
                                Grid.Column="0"
                                Width="30" Height="30"
                                CornerRadius="15"
                                Background="#2610B981"
                                BorderBrush="#10B981"
                                BorderThickness="1.3"
                                VerticalAlignment="Center"
                                Margin="0,0,11,0">
                            <TextBlock x:Name="TxtNotifGlyph"
                                       Text="✓"
                                       Foreground="#10B981"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtNotifTitle"
                                       Text="Zenith Utility"
                                       Foreground="White"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="TxtNotifMessage"
                                       Text="Уведомление"
                                       Foreground="#D1D5DB"
                                       FontSize="11.5"
                                       Margin="0,2,0,0"
                                       TextWrapping="Wrap"
                                       MaxHeight="68"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <Button Grid.Column="2"
                                Style="{StaticResource IslandRoundIconButtonStyle}"
                                Width="22" Height="22"
                                Margin="8,0,0,0"
                                VerticalAlignment="Top"
                                ToolTip="Скрыть уведомление"
                                Click="OnDismissNotificationClicked">
                            <TextBlock Text="✕" FontSize="10" Foreground="#9CA3AF" />
                        </Button>
                    </Grid>

                    <Border Grid.Row="1" Background="#14FFFFFF" HorizontalAlignment="Stretch">
                        <Border x:Name="NotifProgressBar"
                                HorizontalAlignment="Left"
                                Width="380"
                                Background="#10B981" />
                    </Border>
                </Grid>

                <!-- 5. Таймер NextSession -->
                <Grid x:Name="ViewCountdown" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="3" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="14,11,14,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="36" Height="36"
                                CornerRadius="18"
                                Background="#263B82F6"
                                BorderBrush="#60A5FA"
                                BorderThickness="1.5"
                                VerticalAlignment="Center"
                                Margin="0,0,11,0">
                            <TextBlock x:Name="TxtCountdownSeconds"
                                       Text="3"
                                       Foreground="#93C5FD"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock x:Name="TxtCountdownHeader"
                                       Text="Запуск через 3 сек"
                                       Foreground="White"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="TxtCountdownSummary"
                                       Text="Программы (2)"
                                       Foreground="#D1D5DB"
                                       FontSize="11"
                                       Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="TxtCountdownNote"
                                       Foreground="#93C5FD"
                                       FontSize="10.5"
                                       Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="Collapsed" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource IslandAccentButtonStyle}"
                                    Content="Запустить"
                                    Padding="10,6"
                                    Margin="0,0,6,0"
                                    Click="OnCountdownRunNowClicked" />
                            <Button Style="{StaticResource IslandIconButtonStyle}"
                                    Content="Отмена"
                                    Padding="9,6"
                                    Click="OnCountdownCancelClicked" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Background="#14FFFFFF" HorizontalAlignment="Stretch">
                        <Border x:Name="CountdownProgressBar"
                                HorizontalAlignment="Left"
                                Width="400"
                                Background="#3B82F6" />
                    </Border>
                </Grid>

                <!-- 6. Развёрнутый ящик: Медиа + Полка буфера обмена -->
                <StackPanel x:Name="ViewExpandedDrawer" Visibility="Collapsed" Margin="14,11,14,13">
                    <!-- Шапка -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="8" Height="8" CornerRadius="4" Background="#3B82F6" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Островок" Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtDrawerShelfSummary"
                                       Text="· Полка пуста"
                                       Foreground="#9CA3AF"
                                       FontSize="11.5"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource IslandIconButtonStyle}"
                                    Content="+ Из буфера"
                                    Margin="0,0,6,0"
                                    ToolTip="Добавить текст или файлы из системного буфера обмена"
                                    Click="OnAddFromClipboardClicked" />
                            <Button x:Name="BtnClearShelf"
                                    Style="{StaticResource IslandIconButtonStyle}"
                                    Content="Очистить"
                                    Margin="0,0,6,0"
                                    Visibility="Collapsed"
                                    Click="OnClearShelfClicked" />
                            <Button Style="{StaticResource IslandRoundIconButtonStyle}"
                                    ToolTip="Свернуть островок"
                                    Click="OnCollapseDrawerClicked">
                                <TextBlock Text="▲" FontSize="9" Foreground="#D1D5DB" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Активная музыка / медиаплеер -->
                    <Border x:Name="MediaCard"
                            Visibility="Collapsed"
                            Background="#16FFFFFF"
                            BorderBrush="#22FFFFFF"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="10,8"
                            Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Width="38" Height="38"
                                    CornerRadius="9"
                                    Background="#24FFFFFF"
                                    ClipToBounds="True"
                                    Margin="0,0,10,0">
                                <Grid>
                                    <TextBlock Text="🎵" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image x:Name="ImgMediaThumb" Stretch="UniformToFill" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock x:Name="TxtMediaTitle"
                                           Text="Трек"
                                           Foreground="White"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="TxtMediaArtist"
                                           Text="Исполнитель"
                                           Foreground="#9CA3AF"
                                           FontSize="11"
                                           Margin="0,1,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource IslandRoundIconButtonStyle}"
                                        Margin="0,0,4,0"
                                        ToolTip="Предыдущий трек"
                                        Click="OnMediaPrevClicked">
                                    <TextBlock Text="⏮" FontSize="11" />
                                </Button>
                                <Button Style="{StaticResource IslandRoundIconButtonStyle}"
                                        Background="#3B82F6"
                                        Margin="0,0,4,0"
                                        ToolTip="Пауза / Воспроизведение"
                                        Click="OnMediaPlayPauseClicked">
                                    <TextBlock x:Name="TxtMediaPlayPauseIcon" Text="▶" FontSize="11" Foreground="White" />
                                </Button>
                                <Button Style="{StaticResource IslandRoundIconButtonStyle}"
                                        ToolTip="Следующий трек"
                                        Click="OnMediaNextClicked">
                                    <TextBlock Text="⏭" FontSize="11" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Пустое состояние полки -->
                    <Border x:Name="ShelfEmptyBox"
                            Background="#0DFFFFFF"
                            BorderBrush="#2EFFFFFF"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="14,16">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Полка буфера: перетащите сюда текст или файлы"
                                       Foreground="#E5E7EB"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center" />
                            <TextBlock Text="Затем просто потяните элемент мышкой из островка в любое окно или папку"
                                       Foreground="#9CA3AF"
                                       FontSize="11"
                                       Margin="0,4,0,0"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Список элементов полки (перетаскиваемые) -->
                    <ScrollViewer x:Name="ShelfScrollViewer"
                                  Visibility="Collapsed"
                                  MaxHeight="210"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="ShelfItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,6"
                                            Padding="10,8"
                                            CornerRadius="12"
                                            Background="#17FFFFFF"
                                            BorderBrush="#22FFFFFF"
                                            BorderThickness="1"
                                            Cursor="SizeAll"
                                            ToolTip="Потяните мышкой, чтобы перетащить в другое окно"
                                            PreviewMouseLeftButtonDown="OnShelfItemMouseDown"
                                            PreviewMouseMove="OnShelfItemMouseMove"
                                            PreviewMouseLeftButtonUp="OnShelfItemMouseUp">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="⋮⋮"
                                                       Foreground="#6B7280"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,7,0" />

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding KindGlyph}"
                                                       FontSize="15"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,9,0" />

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Title}"
                                                           Foreground="White"
                                                           FontSize="12"
                                                           FontWeight="Medium"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Subtitle}"
                                                           Foreground="#9CA3AF"
                                                           FontSize="10.5"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <Button Grid.Column="3"
                                                    Style="{StaticResource IslandRoundIconButtonStyle}"
                                                    Width="24" Height="24"
                                                    Margin="0,0,4,0"
                                                    Tag="{Binding}"
                                                    ToolTip="Скопировать в буфер обмена"
                                                    Click="OnCopyShelfItemClicked">
                                                <TextBlock Text="⧉" FontSize="11" Foreground="#D1D5DB" />
                                            </Button>

                                            <Button Grid.Column="4"
                                                    Style="{StaticResource IslandRoundIconButtonStyle}"
                                                    Width="24" Height="24"
                                                    Tag="{Binding}"
                                                    ToolTip="Удалить с полки"
                                                    Click="OnRemoveShelfItemClicked">
                                                <TextBlock Text="✕" FontSize="10" Foreground="#FCA5A5" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Кнопки группового перетаскивания -->
                    <Grid x:Name="BulkDragPanel" Visibility="Collapsed" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="BtnDragAllFiles"
                                Grid.Column="0"
                                Visibility="Collapsed"
                                Background="#263B82F6"
                                BorderBrush="#6660A5FA"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="10,7"
                                Margin="0,0,4,0"
                                Cursor="SizeAll"
                                PreviewMouseLeftButtonDown="OnDragAllFilesMouseDown"
                                PreviewMouseMove="OnDragAllFilesMouseMove"
                                PreviewMouseLeftButtonUp="OnDragAllMouseUp">
                            <TextBlock x:Name="TxtDragAllFiles"
                                       Text="Перетащить все файлы"
                                       Foreground="#DBEAFE"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </Border>

                        <Border x:Name="BtnDragAllText"
                                Grid.Column="1"
                                Visibility="Collapsed"
                                Background="#20FFFFFF"
                                BorderBrush="#33FFFFFF"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="10,7"
                                Margin="4,0,0,0"
                                Cursor="SizeAll"
                                PreviewMouseLeftButtonDown="OnDragAllTextMouseDown"
                                PreviewMouseMove="OnDragAllTextMouseMove"
                                PreviewMouseLeftButtonUp="OnDragAllMouseUp">
                            <TextBlock x:Name="TxtDragAllText"
                                       Text="Перетащить весь текст"
                                       Foreground="#E5E7EB"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </Border>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
