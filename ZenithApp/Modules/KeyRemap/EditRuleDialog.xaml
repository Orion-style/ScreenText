<ui:FluentWindow x:Class="ZenithApp.Modules.KeyRemap.EditRuleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:ZenithApp.Modules.KeyRemap"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Height="660" Width="580"
        MinHeight="520" MinWidth="500"
        WindowStartupLocation="CenterOwner"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Заголовок окна -->
        <ui:TitleBar Grid.Row="0" 
                     Title="{Binding Title}" 
                     ShowMaximize="False" 
                     ShowMinimize="False" />

        <!-- Основное содержимое -->
        <ScrollViewer Grid.Row="1" 
                      Margin="20,4,20,0"
                      Padding="0,0,14,10"
                      HorizontalScrollBarVisibility="Disabled" 
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Описание / Имя правила -->
                <TextBlock Text="Название правила (необязательно)" FontWeight="SemiBold" Margin="0,0,0,6" TextWrapping="Wrap" />
                <ui:TextBox Text="{Binding RuleName, UpdateSourceTrigger=PropertyChanged}" 
                            PlaceholderText="Например: CapsLock в Backspace или Ctrl+K в M" 
                            Margin="0,0,0,14" />

                <!-- Исходная клавиша / Сочетание -->
                <TextBlock Text="Исходная клавиша или комбинация" FontWeight="SemiBold" Margin="0,0,0,4" TextWrapping="Wrap" />
                <TextBlock Text="Нажмите на поле и нажмите клавишу/сочетание на клавиатуре, либо настройте модификаторы:" 
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,6" TextWrapping="Wrap" />
                <TextBox x:Name="TxtTriggerKey"
                         Text="{Binding TriggerDisplay, Mode=OneWay}"
                         IsReadOnly="True"
                         Cursor="Hand"
                         Focusable="True"
                         TextAlignment="Center"
                         FontWeight="Bold"
                         Height="38"
                         VerticalContentAlignment="Center"
                         PreviewKeyDown="OnTriggerKeyDown"
                         Margin="0,0,0,8" />

                <!-- Чекбоксы модификаторов для исходной комбинации (равномерное распределение) -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" Content="Ctrl" MinWidth="0" IsChecked="{Binding TriggerCtrl, Mode=TwoWay}" HorizontalAlignment="Left" />
                    <CheckBox Grid.Column="1" Content="Alt" MinWidth="0" IsChecked="{Binding TriggerAlt, Mode=TwoWay}" HorizontalAlignment="Left" />
                    <CheckBox Grid.Column="2" Content="Shift" MinWidth="0" IsChecked="{Binding TriggerShift, Mode=TwoWay}" HorizontalAlignment="Left" />
                    <CheckBox Grid.Column="3" Content="Win" MinWidth="0" IsChecked="{Binding TriggerWin, Mode=TwoWay}" HorizontalAlignment="Left" />
                </Grid>

                <!-- Тип действия -->
                <TextBlock Text="Действие" FontWeight="SemiBold" Margin="0,0,0,6" TextWrapping="Wrap" />
                <ComboBox SelectedIndex="{Binding ActionTypeIndex, Mode=TwoWay}" Margin="0,0,0,14" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="Заменить на другую клавишу" />
                    <ComboBoxItem Content="Заменить на сочетание клавиш" />
                    <ComboBoxItem Content="Отключить клавишу или комбинацию (подавить)" />
                    <ComboBoxItem Content="Сменить язык ввода (Alt + Shift)" />
                </ComboBox>

                <!-- Целевая клавиша или сочетание (если не отключить) -->
                <StackPanel Visibility="{Binding IsTargetVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,14">
                    <TextBlock Text="Целевая клавиша или комбинация" FontWeight="SemiBold" Margin="0,0,0,4" TextWrapping="Wrap" />
                    <TextBlock Text="Нажмите на поле и нажмите нужную клавишу на клавиатуре:" 
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,6" TextWrapping="Wrap" />
                    <TextBox x:Name="TxtTargetKey"
                             Text="{Binding TargetDisplay, Mode=OneWay}"
                             IsReadOnly="True"
                             Cursor="Hand"
                             Focusable="True"
                             TextAlignment="Center"
                             FontWeight="Bold"
                             Height="38"
                             VerticalContentAlignment="Center"
                             PreviewKeyDown="OnTargetKeyDown"
                             Margin="0,0,0,8" />

                    <!-- Чекбоксы модификаторов для комбинации -->
                    <Grid Visibility="{Binding IsComboModifiersVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" Content="Ctrl" MinWidth="0" IsChecked="{Binding TargetCtrl, Mode=TwoWay}" HorizontalAlignment="Left" />
                        <CheckBox Grid.Column="1" Content="Alt" MinWidth="0" IsChecked="{Binding TargetAlt, Mode=TwoWay}" HorizontalAlignment="Left" />
                        <CheckBox Grid.Column="2" Content="Shift" MinWidth="0" IsChecked="{Binding TargetShift, Mode=TwoWay}" HorizontalAlignment="Left" />
                        <CheckBox Grid.Column="3" Content="Win" MinWidth="0" IsChecked="{Binding TargetWin, Mode=TwoWay}" HorizontalAlignment="Left" />
                    </Grid>
                </StackPanel>

                <!-- Фильтр приложений -->
                <ui:Card Padding="14,12" Margin="0,0,0,14">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                <TextBlock Text="Фильтр по приложениям" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="Применять правило только в определенных программах" 
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                           FontSize="12" 
                                           TextWrapping="Wrap" 
                                           Margin="0,2,0,0" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" 
                                             IsChecked="{Binding EnableAppFilter, Mode=TwoWay}" 
                                             VerticalAlignment="Center" />
                        </Grid>
                        
                        <StackPanel Margin="0,12,0,0" Visibility="{Binding EnableAppFilter, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <RadioButton Content="Только в этих:" MinWidth="0" IsChecked="{Binding AppFilterIsWhitelist, Mode=TwoWay}" Margin="0,0,16,4" />
                                <RadioButton Content="Везде, кроме этих:" MinWidth="0" Margin="0,0,0,4" />
                            </WrapPanel>
                            <ui:TextBox Text="{Binding FilterProcessesText, UpdateSourceTrigger=PropertyChanged}" 
                                        PlaceholderText="notepad, chrome, telegram" />
                        </StackPanel>
                    </StackPanel>
                </ui:Card>

                <!-- Ошибка валидации -->
                <ui:InfoBar Title="Внимание" 
                            Message="{Binding ValidationError}" 
                            IsOpen="{Binding HasValidationError}" 
                            Severity="Error" 
                            IsClosable="False" 
                            Margin="0,0,0,10" />
            </StackPanel>
        </ScrollViewer>

        <!-- Кнопки действий -->
        <Grid Grid.Row="2" Margin="20,10,20,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Отмена" MinWidth="105" Padding="16,7" Margin="0,0,10,0" Click="OnCancelClick" />
                <ui:Button Content="Сохранить" Appearance="Primary" MinWidth="125" Padding="16,7" Click="OnSaveClick" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
