<UserControl x:Class="ZenithApp.Modules.KeyRemap.KeyRemapSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:ZenithApp.Modules.KeyRemap"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="650">
    <StackPanel>
        <!-- Уведомление об аварийном отключении -->
        <ui:InfoBar Title="Аварийный сброс"
                    Message="{Binding EmergencyNotification}"
                    IsOpen="{Binding ShowEmergencyNotification}"
                    Severity="Warning"
                    IsClosable="True"
                    Margin="0,0,0,12" />

        <!-- Важная плашка с системными ограничениями (UIPI / Античиты) -->
        <ui:Card Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="26" Margin="0,0,14,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Системная безопасность и ограничения Windows" FontWeight="SemiBold" FontSize="14" />
                    <TextBlock Text="Хук работает на уровне пользователя без драйверов. В окнах от имени Администратора (если Zenith не запущен от администратора) и играх с Kernel-античитом перехват блокируется защитой UIPI Windows." 
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                               FontSize="12" 
                               TextWrapping="Wrap" 
                               Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
        </ui:Card>

        <!-- Настройка аварийного выхода -->
        <ui:Card Padding="16" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Аварийное отключение (Kill-switch)" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock Text="{Binding EmergencyShortcutText, StringFormat='Удерживайте {0} для мгновенного отключения всех правил при сбое ввода'}" 
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                               Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <ui:ToggleSwitch Grid.Column="1" 
                                 IsChecked="{Binding EmergencyEscapeEnabled, Mode=TwoWay}" 
                                 VerticalAlignment="Center" />
            </Grid>
        </ui:Card>

        <!-- Заголовок таблицы правил и кнопка создания -->
        <Grid Margin="0,4,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Правила переназначения" FontWeight="Bold" FontSize="16" />
                <TextBlock Text="Список активных замен и подавления клавиш" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
            </StackPanel>
            <ui:Button Grid.Column="1" 
                       Content="Добавить правило" 
                       Icon="{ui:SymbolIcon Add24}" 
                       Appearance="Primary" 
                       Click="OnAddRuleClicked" />
        </Grid>

        <!-- Список правил -->
        <ItemsControl ItemsSource="{Binding Rules}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type local:RuleItemViewModel}">
                    <ui:Card Padding="14" Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Исходная клавиша -->
                            <Border Grid.Column="0" Background="{DynamicResource CardStrokeColorDefaultBrush}" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding TriggerText}" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Border>

                            <!-- Стрелка -->
                            <ui:SymbolIcon Grid.Column="1" Symbol="ArrowRight24" Margin="10,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                            <!-- Действие -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="{Binding ActionSummary}" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Text="{Binding FilterSummary}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" Margin="0,2,0,0" />
                            </StackPanel>

                            <!-- Переключатель активности правила -->
                            <ui:ToggleSwitch Grid.Column="3" IsChecked="{Binding IsEnabled, Mode=TwoWay}" Margin="0,0,12,0" VerticalAlignment="Center" />

                            <!-- Кнопка редактировать -->
                            <ui:Button Grid.Column="4" Icon="{ui:SymbolIcon Edit24}" Command="{Binding EditCommand}" Margin="0,0,6,0" VerticalAlignment="Center" />

                            <!-- Кнопка удалить -->
                            <ui:Button Grid.Column="5" Icon="{ui:SymbolIcon Delete24}" Appearance="Danger" Command="{Binding DeleteCommand}" VerticalAlignment="Center" />

                            <!-- Предупреждение о конфликте клавиш -->
                            <ui:InfoBar Grid.Row="1" Grid.ColumnSpan="6"
                                        Title="Конфликт клавиш"
                                        Message="{Binding ConflictWarning}"
                                        IsOpen="{Binding HasConflict}"
                                        Severity="Warning"
                                        IsClosable="False"
                                        Margin="0,8,0,0" />
                        </Grid>
                    </ui:Card>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Сообщение, если список правил пуст -->
        <Border Padding="32" 
                Background="{DynamicResource CardBackground}" 
                CornerRadius="8" 
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Rules.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel HorizontalAlignment="Center">
                <ui:SymbolIcon Symbol="Keyboard24" FontSize="36" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,8" />
                <TextBlock Text="Правила не настроены" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="Нажмите кнопку «Добавить правило», чтобы назначить замену или отключение клавиши." 
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                           HorizontalAlignment="Center" 
                           TextAlignment="Center" 
                           Margin="0,4,0,0" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
