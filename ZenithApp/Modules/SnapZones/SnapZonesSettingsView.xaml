<UserControl x:Class="ZenithApp.Modules.SnapZones.SnapZonesSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="600">
    <StackPanel>
        <!-- Горячая клавиша закрепления -->
        <ui:Card Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Горячая клавиша закрепления" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock Text="Нажмите клавиши на активном окне, чтобы закрепить его поверх всех окон (или открепить)" 
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                               Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="12,6" VerticalAlignment="Center">
                    <TextBlock Text="{Binding HotkeyDisplayText}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </Border>
            </Grid>
        </ui:Card>

        <!-- Визуальная рамка-индикатор -->
        <ui:Card Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Цветная рамка вокруг закреплённого окна" FontWeight="SemiBold" FontSize="15" />
                        <TextBlock Text="Отображает контрастный контур, чтобы визуально отличать закреплённое окно" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                   Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" 
                                     IsChecked="{Binding ShowBorder, Mode=TwoWay}" 
                                     VerticalAlignment="Center" />
                </Grid>

                <!-- Толщина рамки -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Толщина рамки" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Slider Minimum="1" Maximum="10" Value="{Binding BorderThickness, Mode=TwoWay}" Width="120" Margin="0,0,10,0" TickFrequency="1" IsSnapToTickEnabled="True" />
                        <TextBlock Text="{Binding BorderThicknessText}" Width="45" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- Звуковой сигнал -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Звуковое подтверждение при закреплении" VerticalAlignment="Center" />
                    <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding PlayNotificationSound, Mode=TwoWay}" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </ui:Card>

        <!-- Исключения -->
        <ui:Card Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Исключённые приложения" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,4" />
                <TextBlock Text="Окна этих программ не будут закрепляться поверх остальных" 
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                           Margin="0,0,0,12" TextWrapping="Wrap" />

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox Grid.Column="0" 
                                PlaceholderText="Имя процесса (например, game или player)" 
                                Text="{Binding NewProcessName, UpdateSourceTrigger=PropertyChanged}" 
                                Margin="0,0,8,0" />
                    <ui:Button Grid.Column="1" 
                               Content="Добавить" 
                               Icon="{ui:SymbolIcon Add20}" 
                               Command="{Binding AddExcludedProcessCommand}" />
                </Grid>

                <ItemsControl ItemsSource="{Binding ExcludedProcesses}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                    CornerRadius="6" 
                                    Padding="10,6" 
                                    Margin="0,2,0,2">
                                <Grid>
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" FontWeight="Medium" />
                                    <ui:Button HorizontalAlignment="Right" 
                                               Padding="6,2" 
                                               Icon="{ui:SymbolIcon Dismiss16}" 
                                               ToolTip="Удалить из исключений"
                                               Command="{Binding DataContext.RemoveExcludedProcessCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ui:Card>
    </StackPanel>
</UserControl>
