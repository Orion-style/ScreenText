<UserControl x:Class="ZenithApp.Modules.StartupManager.StartupManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:ZenithApp.Modules.StartupManager"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="650">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Верхняя панель: поиск, статистика и кнопка обновления -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:TextBox Grid.Column="0"
                        PlaceholderText="Поиск по названию, издателю или пути..."
                        Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}"
                        Icon="{ui:SymbolIcon Search24}"
                        ClearButtonEnabled="True"
                        Margin="0,0,10,0" />

            <ui:Button Grid.Column="1"
                       Content="Обновить"
                       Icon="{ui:SymbolIcon ArrowClockwise24}"
                       Command="{Binding RefreshCommand}" />
        </Grid>

        <!-- Статистика -->
        <TextBlock Grid.Row="1"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   FontSize="12"
                   Margin="2,0,0,10">
            <Run Text="Всего элементов:" />
            <Run Text="{Binding TotalCount, Mode=OneWay}" FontWeight="SemiBold" />
            <Run Text="•  Включено:" />
            <Run Text="{Binding EnabledCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource SystemAccentColorLight1Brush}" />
        </TextBlock>

        <!-- Список элементов автозагрузки -->
        <Border Grid.Row="2"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="6">
            <Grid>
                <!-- Сообщение когда список пуст -->
                <TextBlock Text="Программы в автозагрузке не найдены"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="14">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FilteredItems.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ItemsControl ItemsSource="{Binding FilteredItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:StartupItemViewModel}">
                            <Border Margin="0,2"
                                    Padding="8,8"
                                    CornerRadius="6"
                                    Background="Transparent">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid Margin="4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Иконка приложения -->
                                    <ui:SymbolIcon Symbol="AppGeneric24"
                                                   FontSize="22"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,0" />

                                    <!-- Описание и детали -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Name}" 
                                                   FontWeight="SemiBold" 
                                                   FontSize="14"
                                                   TextTrimming="CharacterEllipsis" />
                                        <WrapPanel Margin="0,2,0,0">
                                            <TextBlock Text="{Binding Publisher}" 
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                                       FontSize="12" />
                                            <TextBlock Text=" • " 
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" 
                                                       FontSize="12" />
                                            <TextBlock Text="{Binding LocationDisplayName}" 
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" 
                                                       FontSize="12" />
                                        </WrapPanel>
                                        <TextBlock Text="{Binding Command}" 
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" 
                                                   FontSize="11" 
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Command}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>

                                    <!-- Кнопка перехода к файлу -->
                                    <ui:Button Grid.Column="2"
                                               Icon="{ui:SymbolIcon FolderOpen24}"
                                               ToolTip="Открыть расположение файла"
                                               Command="{Binding OpenLocationCommand}"
                                               Appearance="Transparent"
                                               Padding="6"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0" />

                                    <!-- Переключатель вкл / выкл -->
                                    <ui:ToggleSwitch Grid.Column="3"
                                                     IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                     VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>
