<UserControl x:Class="ZenithApp.Modules.StartupManager.StartupManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:ZenithApp.Modules.StartupManager"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="650">

    <UserControl.Resources>
        <!-- Стиль сегментированных вкладок-фильтров в стиле Windows 11 -->
        <Style x:Key="TabRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Верхняя панель: поиск и кнопка обновления -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:TextBox Grid.Column="0"
                        PlaceholderText="Поиск программ..."
                        Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}"
                        Icon="{ui:SymbolIcon Search24}"
                        ClearButtonEnabled="True"
                        Margin="0,0,10,0" />

            <ui:Button Grid.Column="1"
                       Content="Обновить"
                       Icon="{ui:SymbolIcon ArrowClockwise24}"
                       Command="{Binding RefreshCommand}" />
        </Grid>

        <!-- Фильтры категорий (Вкладки) -->
        <Border Grid.Row="1"
                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="3"
                Margin="0,0,0,10"
                HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="Все"
                             GroupName="StartupCategoryGroup"
                             IsChecked="{Binding SelectedFilterTab, Converter={x:Static local:StartupTabConverter.Instance}, ConverterParameter=0, Mode=TwoWay}"
                             Style="{StaticResource TabRadioButtonStyle}" />
                <RadioButton Content="В автозагрузке"
                             GroupName="StartupCategoryGroup"
                             IsChecked="{Binding SelectedFilterTab, Converter={x:Static local:StartupTabConverter.Instance}, ConverterParameter=1, Mode=TwoWay}"
                             Style="{StaticResource TabRadioButtonStyle}" />
                <RadioButton Content="Доступные программы"
                             GroupName="StartupCategoryGroup"
                             IsChecked="{Binding SelectedFilterTab, Converter={x:Static local:StartupTabConverter.Instance}, ConverterParameter=2, Mode=TwoWay}"
                             Style="{StaticResource TabRadioButtonStyle}" />
            </StackPanel>
        </Border>

        <!-- Статистика -->
        <TextBlock Grid.Row="2"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   FontSize="12"
                   Margin="2,0,0,10">
            <Run Text="Всего:" />
            <Run Text="{Binding TotalCount, Mode=OneWay}" FontWeight="SemiBold" />
            <Run Text="•  В автозагрузке:" />
            <Run Text="{Binding StartupCount, Mode=OneWay}" FontWeight="SemiBold" />
            <Run Text="•  Включено:" />
            <Run Text="{Binding EnabledCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource SystemAccentColorLight1Brush}" />
            <Run Text="•  Доступно для добавления:" />
            <Run Text="{Binding AvailableCount, Mode=OneWay}" FontWeight="SemiBold" />
        </TextBlock>

        <!-- Список элементов автозагрузки -->
        <Border Grid.Row="3"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="6">
            <Grid>
                <!-- Сообщение когда список пуст -->
                <TextBlock Text="Программы не найдены"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="14">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FilteredItems.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ItemsControl ItemsSource="{Binding FilteredItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:StartupItemViewModel}">
                            <Border Margin="0,2"
                                    Padding="8,8"
                                    CornerRadius="6"
                                    Background="Transparent">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid Margin="4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Иконка приложения -->
                                    <Grid Width="26" Height="26" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <!-- Реальная иконка программы -->
                                        <Image Source="{Binding Icon}"
                                               Width="24"
                                               Height="24"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>

                                        <!-- Запасная векторная иконка при отсутствии файла/иконки -->
                                        <ui:SymbolIcon Symbol="AppGeneric24"
                                                       FontSize="22"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center">
                                            <ui:SymbolIcon.Style>
                                                <Style TargetType="ui:SymbolIcon">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:SymbolIcon.Style>
                                        </ui:SymbolIcon>
                                    </Grid>

                                    <!-- Название приложения и статус -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Name}" 
                                                   FontWeight="SemiBold" 
                                                   FontSize="14"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Border CornerRadius="4"
                                                Margin="8,0,0,0"
                                                Padding="6,1"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource SubtleFillColorTertiaryBrush}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsInstalledOnly}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="Доступно" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Кнопка перехода к файлу -->
                                    <ui:Button Grid.Column="2"
                                               Icon="{ui:SymbolIcon FolderOpen24}"
                                               ToolTip="Открыть расположение файла"
                                               Command="{Binding OpenLocationCommand}"
                                               Appearance="Transparent"
                                               Padding="6"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0" />

                                    <!-- Переключатель вкл / выкл автозагрузки -->
                                    <ui:ToggleSwitch Grid.Column="3"
                                                     IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                     ToolTip="Включить в автозагрузку при старте Windows"
                                                     VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>
