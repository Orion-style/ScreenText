<UserControl x:Class="ZenithApp.Modules.T9Predictor.T9PredictorSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="600">
    <StackPanel>
        <!-- Языковые словари -->
        <ui:Card Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Языковые словари" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,4" />
                <TextBlock Text="Автономные бинарные частотные словари без отправки данных в сеть" 
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                           Margin="0,0,0,12" TextWrapping="Wrap" />

                <Grid Margin="0,0,0,10">
                    <TextBlock Text="Русский язык (НКРЯ / OpenCorpora)" VerticalAlignment="Center" />
                    <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding EnableRussian, Mode=TwoWay}" />
                </Grid>

                <Grid>
                    <TextBlock Text="Английский язык (Web Corpus / SCOWL)" VerticalAlignment="Center" />
                    <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding EnableEnglish, Mode=TwoWay}" />
                </Grid>
            </StackPanel>
        </ui:Card>

        <!-- Параметры подсказки -->
        <ui:Card Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <!-- Минимальная длина префикса -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Минимальная длина префикса для подсказки" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Slider Minimum="1" Maximum="5" Value="{Binding MinPrefixLength, Mode=TwoWay}" Width="120" Margin="0,0,10,0" TickFrequency="1" IsSnapToTickEnabled="True" />
                        <TextBlock Text="{Binding MinPrefixLengthText}" Width="55" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- Прозрачность подсказки -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Прозрачность текста подсказки" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Slider Minimum="20" Maximum="90" Value="{Binding HintOpacityPercent, Mode=TwoWay}" Width="120" Margin="0,0,10,0" TickFrequency="5" IsSnapToTickEnabled="True" />
                        <TextBlock Text="{Binding HintOpacityText}" Width="55" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- Клавиша принятия -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Клавиша принятия подсказки" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" SelectedIndex="{Binding SelectedAcceptKeyIndex, Mode=TwoWay}" Width="160">
                        <ComboBoxItem Content="Tab" />
                        <ComboBoxItem Content="Стрелка вправо (→)" />
                        <ComboBoxItem Content="Enter" />
                    </ComboBox>
                </Grid>

                <!-- Пробел после слова -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Добавлять пробел после вставки слова" VerticalAlignment="Center" />
                    <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding AddSpaceAfterWord, Mode=TwoWay}" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </ui:Card>

        <!-- Горячая клавиша паузы -->
        <ui:Card Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Горячая клавиша паузы / возобновления" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock Text="Быстро временно отключить автодополнение, если нужно напечатать специальный текст" 
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                               Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="12,6" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PauseHotkeyText}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </Border>
            </Grid>
        </ui:Card>

        <!-- Исключения -->
        <ui:Card Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Исключённые приложения" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,4" />
                <TextBlock Text="Менеджеры паролей, терминалы и банковские клиенты по умолчанию отключены для конфиденциальности" 
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                           Margin="0,0,0,12" TextWrapping="Wrap" />

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox Grid.Column="0" 
                                PlaceholderText="Имя процесса (например, keepass или cmd)" 
                                Text="{Binding NewProcessName, UpdateSourceTrigger=PropertyChanged}" 
                                Margin="0,0,8,0" />
                    <ui:Button Grid.Column="1" 
                               Content="Добавить" 
                               Icon="{ui:SymbolIcon Add20}" 
                               Command="{Binding AddExcludedProcessCommand}" />
                </Grid>

                <ItemsControl ItemsSource="{Binding ExcludedProcesses}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                    CornerRadius="6" 
                                    Padding="10,6" 
                                    Margin="0,2,0,2">
                                <Grid>
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" FontWeight="Medium" />
                                    <ui:Button HorizontalAlignment="Right" 
                                               Padding="6,2" 
                                               Icon="{ui:SymbolIcon Dismiss16}" 
                                               ToolTip="Удалить из исключений"
                                               Command="{Binding DataContext.RemoveExcludedProcessCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ui:Card>
    </StackPanel>
</UserControl>
