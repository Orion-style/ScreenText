<Window x:Class="ZenithApp.Modules.RadialSwitcher.RadialWheelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="500" Height="500"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <DropShadowEffect x:Key="WheelShadow" BlurRadius="28" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.55" />
        <DropShadowEffect x:Key="GlowEffect" BlurRadius="18" ShadowDepth="0" Color="#E5C158" Opacity="0.75" />
    </Window.Resources>

    <Grid x:Name="RootGrid" Width="500" Height="500" Effect="{StaticResource WheelShadow}">
        <!-- Холст для секторов колеса -->
        <Canvas x:Name="SectorsCanvas" Width="500" Height="500" />

        <!-- Центральный круг (текущее окно / подсказка действия) -->
        <Grid Width="150" Height="150" HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Фоновый диск центра -->
            <Ellipse Fill="#F018181C" Stroke="#50FFFFFF" StrokeThickness="2" />
            
            <!-- Внутреннее декоративное кольцо (стиль Genshin) -->
            <Ellipse Margin="6" Fill="Transparent" Stroke="#30E5C158" StrokeThickness="1" StrokeDashArray="3,3" />

            <!-- Содержимое центра: когда курсор в центре -->
            <StackPanel x:Name="CenterActivePanel" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10">
                <Border Width="44" Height="44" CornerRadius="10" Background="#20FFFFFF" Padding="4" HorizontalAlignment="Center" Margin="0,0,0,6">
                    <Image x:Name="ImgCenterActiveApp" Stretch="Uniform" />
                </Border>
                <TextBlock x:Name="TxtCenterActiveTitle" 
                           FontSize="11.5" 
                           FontWeight="SemiBold" 
                           Foreground="#FFFFFF" 
                           HorizontalAlignment="Center" 
                           TextAlignment="Center" 
                           TextTrimming="CharacterEllipsis" 
                           MaxWidth="120" />
                <TextBlock Text="Текущее окно" 
                           FontSize="9.5" 
                           Foreground="#80FFFFFF" 
                           HorizontalAlignment="Center" 
                           Margin="0,2,0,0" />
            </StackPanel>

            <!-- Содержимое центра: при наведении на сектор -->
            <StackPanel x:Name="CenterHoverPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10" Visibility="Collapsed">
                <Border Width="44" Height="44" CornerRadius="10" Background="#30E5C158" BorderBrush="#E5C158" BorderThickness="1.5" Padding="4" HorizontalAlignment="Center" Margin="0,0,0,4">
                    <Image x:Name="ImgCenterHoverApp" Stretch="Uniform" />
                </Border>
                <TextBlock x:Name="TxtCenterHoverTitle" 
                           FontSize="12" 
                           FontWeight="Bold" 
                           Foreground="#FCE794" 
                           HorizontalAlignment="Center" 
                           TextAlignment="Center" 
                           TextTrimming="CharacterEllipsis" 
                           MaxWidth="125" />
                <TextBlock Text="Отпустите Tab" 
                           FontSize="9.5" 
                           FontWeight="SemiBold" 
                           Foreground="#10B981" 
                           HorizontalAlignment="Center" 
                           Margin="0,2,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
