<Window x:Class="ZenithApp.Modules.RadialSwitcher.RadialWheelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Width="400" Height="400"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <DropShadowEffect x:Key="WheelShadow" BlurRadius="22" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.5" />
        <DropShadowEffect x:Key="GlowEffect" BlurRadius="14" ShadowDepth="0" Color="#E5C158" Opacity="0.75" />
    </Window.Resources>

    <Grid x:Name="RootGrid" Width="400" Height="400" Effect="{StaticResource WheelShadow}">
        <!-- Холст для секторов колеса -->
        <Canvas x:Name="SectorsCanvas" Width="400" Height="400" />

        <!-- Центральный круг (текущее окно / подсказка действия) -->
        <Grid Width="130" Height="130" HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Фоновый диск центра -->
            <Ellipse Fill="#F018181C" Stroke="#50FFFFFF" StrokeThickness="2" />
            
            <!-- Внутреннее декоративное кольцо (стиль Genshin) -->
            <Ellipse Margin="5" Fill="Transparent" Stroke="#30E5C158" StrokeThickness="1" StrokeDashArray="3,3" />

            <!-- Содержимое центра: когда курсор в центре -->
            <StackPanel x:Name="CenterActivePanel" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="6">
                <Border Width="38" Height="38" CornerRadius="8" Background="#20FFFFFF" Padding="3" HorizontalAlignment="Center" Margin="0,0,0,4">
                    <Image x:Name="ImgCenterActiveApp" Stretch="Uniform" />
                </Border>
                <TextBlock x:Name="TxtCenterActiveTitle" 
                           FontSize="11" 
                           FontWeight="SemiBold" 
                           Foreground="#FFFFFF" 
                           HorizontalAlignment="Center" 
                           TextAlignment="Center" 
                           TextTrimming="CharacterEllipsis" 
                           MaxWidth="112" />
                <TextBlock Text="Текущее окно" 
                           FontSize="9" 
                           Foreground="#80FFFFFF" 
                           HorizontalAlignment="Center" 
                           Margin="0,1,0,0" />
            </StackPanel>

            <!-- Содержимое центра: при наведении на сектор -->
            <StackPanel x:Name="CenterHoverPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="6" Visibility="Collapsed">
                <Border Width="38" Height="38" CornerRadius="8" Background="#30E5C158" BorderBrush="#E5C158" BorderThickness="1.5" Padding="3" HorizontalAlignment="Center" Margin="0,0,0,4">
                    <Image x:Name="ImgCenterHoverApp" Stretch="Uniform" />
                </Border>
                <TextBlock x:Name="TxtCenterHoverTitle" 
                           FontSize="11.5" 
                           FontWeight="Bold" 
                           Foreground="#FCE794" 
                           HorizontalAlignment="Center" 
                           TextAlignment="Center" 
                           TextTrimming="CharacterEllipsis" 
                           MaxWidth="112" />
                <TextBlock x:Name="TxtCenterHoverSub"
                           Text="Отпустите Tab" 
                           FontSize="9" 
                           FontWeight="SemiBold" 
                           Foreground="#10B981" 
                           HorizontalAlignment="Center" 
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="114"
                           Margin="0,1,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
