<UserControl x:Class="ZenithApp.Modules.RadialSwitcher.RadialSwitcherSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:ZenithApp.Modules.RadialSwitcher"
             mc:Ignorable="d" 
             d:DesignWidth="620">

    <StackPanel Margin="0,0,0,24">
        <!-- Описание механики -->
        <Border Margin="0,0,0,16" 
                Padding="16,12" 
                CornerRadius="8" 
                Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Symbol="WindowApps24" 
                               FontSize="22" 
                               Foreground="#E5C158" 
                               VerticalAlignment="Top" 
                               Margin="0,2,12,0" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Переключение окон колесом (стиль Genshin Impact)" 
                               FontWeight="SemiBold" 
                               FontSize="14" />
                    <TextBlock Text="Зажмите клавишу Tab на ~0.2 сек, чтобы открыть круговое меню. Направление движения мыши подсвечивает сектор с нужным окном. Отпустите Tab — фокус мгновенно переключится на выбранное окно. Быстрый одиночный клик по Tab работает как обычная клавиша Tab." 
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                               FontSize="12.5" 
                               TextWrapping="Wrap" 
                               Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Настройка: Количество зон (секторов) -->
        <ui:Card Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Количество секторов в колесе" 
                               FontWeight="SemiBold" 
                               FontSize="14.5" />
                    <TextBlock Text="Выберите количество направлений: 4 (простой крест), 6 или 8 (максимальная вместимость)." 
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                               FontSize="12.5" 
                               Margin="0,4,0,0" />
                </StackPanel>
                <ComboBox Grid.Column="1" 
                          SelectedIndex="{Binding SelectedZoneCountIndex, Mode=TwoWay}" 
                          Width="160"
                          VerticalAlignment="Center">
                    <ComboBoxItem Content="4 сектора" />
                    <ComboBoxItem Content="6 секторов" />
                    <ComboBoxItem Content="8 секторов" />
                </ComboBox>
            </Grid>
        </ui:Card>

        <!-- Настройка: Задержка распознавания удержания Tab -->
        <ui:Card Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Время зажатия Tab для открытия меню" 
                                   FontWeight="SemiBold" 
                                   FontSize="14.5" />
                        <TextBlock Text="Если Tab отпущен быстрее этого времени, срабатывает обычный Tab (отступ/навигация)." 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                   FontSize="12.5" 
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" 
                               Text="{Binding HoldDelayText}" 
                               FontWeight="Bold" 
                               FontSize="14" 
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" 
                               VerticalAlignment="Center" />
                </Grid>
                <Slider Grid.Row="1" 
                        Margin="0,12,0,0"
                        Minimum="140" 
                        Maximum="450" 
                        SmallChange="10" 
                        LargeChange="50" 
                        Value="{Binding HoldDelayMs, Mode=TwoWay}" />
            </Grid>
        </ui:Card>

        <!-- Настройка: Автозапуск закрепленных программ -->
        <ui:Card Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Автозапуск закрепленного приложения при выборе" 
                               FontWeight="SemiBold" 
                               FontSize="14.5" />
                    <TextBlock Text="Если закрепленное за сектором приложение не было запущено, автоматически запустить его." 
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                               FontSize="12.5" 
                               Margin="0,4,0,0" />
                </StackPanel>
                <ui:ToggleSwitch Grid.Column="1" 
                                 IsChecked="{Binding AutoLaunchPinned, Mode=TwoWay}" 
                                 VerticalAlignment="Center" />
            </Grid>
        </ui:Card>

        <!-- Секция: Редактирование зон колеса -->
        <Grid Margin="0,8,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" 
                       Text="Редактор направлений и секторов (Зон)" 
                       FontSize="16" 
                       FontWeight="SemiBold" 
                       VerticalAlignment="Center" />
            
            <ui:Button Grid.Column="1" 
                       Content="Обновить список процессов" 
                       Icon="{ui:SymbolIcon ArrowClockwise20}" 
                       Command="{Binding RefreshProcessesCommand}" 
                       Margin="0,0,8,0" />

            <ui:Button Grid.Column="2" 
                       Content="Сбросить все зоны" 
                       Icon="{ui:SymbolIcon ArrowReset20}" 
                       Command="{Binding ResetZonesCommand}" />
        </Grid>

        <!-- Список редактируемых зон -->
        <ItemsControl ItemsSource="{Binding Zones}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ui:Card Padding="14" Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Верхняя плашка зоны: Заголовок и переключатель режима -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" 
                                        Background="#25E5C158" 
                                        BorderBrush="#80E5C158" 
                                        BorderThickness="1" 
                                        CornerRadius="6" 
                                        Padding="8,3" 
                                        Margin="0,0,10,0">
                                    <TextBlock Text="{Binding DirectionName}" 
                                               FontSize="12" 
                                               FontWeight="SemiBold" 
                                               Foreground="#FCE794" />
                                </Border>

                                <TextBlock Grid.Column="1" 
                                           Text="{Binding StatusDescription}" 
                                           FontSize="12" 
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                           VerticalAlignment="Center" 
                                           TextTrimming="CharacterEllipsis" />

                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <CheckBox Content="Закрепить программу" 
                                              IsChecked="{Binding IsPinned, Mode=TwoWay}" 
                                              VerticalAlignment="Center" 
                                              Margin="0,0,12,0" />
                                    
                                    <ui:Button Content="Сбросить" 
                                               Padding="6,2" 
                                               FontSize="11" 
                                               Command="{Binding ResetZoneCommand}" />
                                </StackPanel>
                            </Grid>

                            <!-- Нижняя строка: выбор процесса и кастомная метка (видима только когда закреплено) -->
                            <Grid Grid.Row="1" Margin="0,10,0,0">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Выбор из запущенных процессов -->
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Выбрать из запущенных:" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding RunningProcessNames}" 
                                              SelectedItem="{Binding PinnedProcessName, Mode=TwoWay}" />
                                </StackPanel>

                                <!-- Или ручной ввод имени процесса -->
                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                    <TextBlock Text="Имя процесса (exe):" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding PinnedProcessName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                PlaceholderText="например chrome" />
                                </StackPanel>

                                <!-- Пользовательская подпись -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Пользовательская подпись:" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding CustomLabel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                PlaceholderText="например Браузер" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </ui:Card>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
