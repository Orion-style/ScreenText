<UserControl x:Class="ZenithApp.Modules.RadialSwitcher.RadialSwitcherSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:ZenithApp.Modules.RadialSwitcher"
             mc:Ignorable="d" 
             d:DesignWidth="660">

    <StackPanel Margin="0,0,0,24">
        <!-- Описание механики -->
        <Border Margin="0,0,0,16" 
                Padding="16,12" 
                CornerRadius="8" 
                Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Symbol="WindowApps24" 
                               FontSize="22" 
                               Foreground="#E5C158" 
                               VerticalAlignment="Top" 
                               Margin="0,2,12,0" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Переключение окон колесом (стиль Genshin Impact)" 
                               FontWeight="SemiBold" 
                               FontSize="14" />
                    <TextBlock Text="Зажмите клавишу Tab на ~0.2 сек, чтобы открыть круговое меню. Направление движения мыши подсвечивает сектор с нужным окном. Отпустите Tab — фокус мгновенно переключится на выбранное окно. Быстрый одиночный клик по Tab работает как обычная клавиша Tab." 
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                               FontSize="12.5" 
                               TextWrapping="Wrap" 
                               Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Настройка: Количество зон (секторов) -->
        <ui:Card Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Количество секторов в колесе" 
                               FontWeight="SemiBold" 
                               FontSize="14.5" />
                    <TextBlock Text="Выберите количество направлений: 4 (простой крест), 6 или 8 (максимальная вместимость)." 
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                               FontSize="12.5" 
                               Margin="0,4,0,0" />
                </StackPanel>
                <ComboBox Grid.Column="1" 
                          SelectedIndex="{Binding SelectedZoneCountIndex, Mode=TwoWay}" 
                          Width="160"
                          VerticalAlignment="Center">
                    <ComboBoxItem Content="4 сектора" />
                    <ComboBoxItem Content="6 секторов" />
                    <ComboBoxItem Content="8 секторов" />
                </ComboBox>
            </Grid>
        </ui:Card>

        <!-- Настройка: Задержка распознавания удержания Tab -->
        <ui:Card Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Время зажатия Tab для открытия меню" 
                                   FontWeight="SemiBold" 
                                   FontSize="14.5" />
                        <TextBlock Text="Если Tab отпущен быстрее этого времени, срабатывает обычный Tab (отступ/навигация)." 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                   FontSize="12.5" 
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" 
                               Text="{Binding HoldDelayText}" 
                               FontWeight="Bold" 
                               FontSize="14" 
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" 
                               VerticalAlignment="Center" />
                </Grid>
                <Slider Grid.Row="1" 
                        Margin="0,12,0,0"
                        Minimum="140" 
                        Maximum="450" 
                        SmallChange="10" 
                        LargeChange="50" 
                        Value="{Binding HoldDelayMs, Mode=TwoWay}" />
            </Grid>
        </ui:Card>

        <!-- Настройка: Автозапуск закрепленных программ -->
        <ui:Card Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Автозапуск закрепленного приложения при выборе" 
                               FontWeight="SemiBold" 
                               FontSize="14.5" />
                    <TextBlock Text="Если закрепленное за сектором приложение не было запущено, автоматически запустить его." 
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                               FontSize="12.5" 
                               Margin="0,4,0,0" />
                </StackPanel>
                <ui:ToggleSwitch Grid.Column="1" 
                                 IsChecked="{Binding AutoLaunchPinned, Mode=TwoWay}" 
                                 VerticalAlignment="Center" />
            </Grid>
        </ui:Card>

        <!-- Подмодуль: Закрепление программ -->
        <ui:Card Padding="18" Margin="0,0,0,16">
            <StackPanel>
                <!-- Заголовок подмодуля -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Pin24" 
                                           FontSize="20" 
                                           Foreground="#E5C158" 
                                           Margin="0,0,8,0" />
                            <TextBlock Text="Закрепление программ" 
                                       FontWeight="Bold" 
                                       FontSize="15" />
                        </StackPanel>
                        <TextBlock Text="Кликните по сектору или символу «+», чтобы закрепить программу. Даже если приложение не запущено, при наведении в колесе Tab его можно быстро запустить. Свободные секторы динамически показывают недавние активные окна (MRU-приоритет)." 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                   FontSize="12.5" 
                                   TextWrapping="Wrap" 
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <ui:Button Grid.Column="1" 
                               Content="Сбросить все" 
                               Appearance="Secondary" 
                               Command="{Binding ResetZonesCommand}"
                               VerticalAlignment="Top" 
                               Margin="8,0,0,0" />
                </Grid>

                <!-- Основная рабочая область: визуальный круг и панель выбранного сектора -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Интерактивный круг со слотами -->
                    <Border Grid.Column="0" 
                            Background="#121216" 
                            BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" 
                            BorderThickness="1" 
                            CornerRadius="12" 
                            Padding="10" 
                            Margin="0,0,16,0"
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Top">
                        <local:RadialWheelConfigControl Width="270" Height="270" />
                    </Border>

                    <!-- Панель настройки выбранного сектора -->
                    <Border Grid.Column="1" 
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="16"
                            VerticalAlignment="Stretch">
                        <StackPanel>
                            <!-- Заголовок выбранного сектора -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Выбранный сектор" 
                                               FontSize="11" 
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding SelectedZone.DirectionName, FallbackValue='Сектор'}" 
                                               FontWeight="Bold" 
                                               FontSize="16" 
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" 
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1" 
                                        CornerRadius="6" 
                                        Padding="8,4" 
                                        VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedZone.IsPinned}" Value="True">
                                                    <Setter Property="Background" Value="#30E5C158" />
                                                    <Setter Property="BorderBrush" Value="#E5C158" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedZone.IsPinned}" Value="False">
                                                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource SurfaceStrokeColorDefaultBrush}" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding SelectedZone.StatusBadgeText, FallbackValue='Свободный сектор'}" 
                                               FontSize="11.5" 
                                               FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedZone.IsPinned}" Value="True">
                                                        <Setter Property="Foreground" Value="#FFE478" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedZone.IsPinned}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>

                            <TextBlock Text="{Binding SelectedZone.StatusDescription}" 
                                       FontSize="12" 
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                       TextWrapping="Wrap" 
                                       Margin="0,0,0,14" />

                            <!-- Кнопка выбора EXE файла -->
                            <TextBlock Text="Назначить приложение:" 
                                       FontWeight="SemiBold" 
                                       FontSize="12" 
                                       Margin="0,0,0,6" />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:Button Grid.Column="0" 
                                           Content="📁 Выбрать файл (.exe)..." 
                                           Appearance="Primary" 
                                           HorizontalAlignment="Stretch"
                                           Command="{Binding SelectedZone.BrowseExeCommand}" />
                                <ui:Button Grid.Column="1" 
                                           Content="❌ Открепить" 
                                           Appearance="Secondary" 
                                           Command="{Binding SelectedZone.UnpinCommand}" 
                                           Margin="8,0,0,0" />
                            </Grid>

                            <!-- Выбор из запущенных программ -->
                            <TextBlock Text="Или выберите из открытых окон:" 
                                       FontSize="12" 
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                       Margin="0,4,0,4" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" 
                                          ItemsSource="{Binding RunningProcessNames}" 
                                          SelectedItem="{Binding SelectedZone.SelectedRunningProcess, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" />
                                <ui:Button Grid.Column="1" 
                                           Content="🔄" 
                                           ToolTip="Обновить список открытых процессов"
                                           Command="{Binding RefreshProcessesCommand}" 
                                           Margin="6,0,0,0" />
                            </Grid>

                            <!-- Пользовательская метка -->
                            <TextBlock Text="Название сектора в меню (опционально):" 
                                       FontSize="12" 
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                       Margin="0,0,0,4" />
                            <ui:TextBox Text="{Binding SelectedZone.CustomLabel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                        PlaceholderText="Оставьте пустым для автоназвания" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ui:Card>
    </StackPanel>
</UserControl>
