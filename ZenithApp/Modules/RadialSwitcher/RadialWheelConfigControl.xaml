<UserControl x:Class="ZenithApp.Modules.RadialSwitcher.RadialWheelConfigControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Width="290" Height="290">
    <Grid Width="290" Height="290">
        <!-- Холст для секторов колеса -->
        <Canvas x:Name="WheelCanvas" Width="290" Height="290" />

        <!-- Центральный круг -->
        <Border Width="68" Height="68" 
                CornerRadius="34" 
                Background="#EE181820" 
                BorderBrush="#40FFFFFF" 
                BorderThickness="1.5"
                HorizontalAlignment="Center" 
                VerticalAlignment="Center"
                IsHitTestVisible="False">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ui:SymbolIcon Symbol="Pin20" Foreground="#E5C158" FontSize="18" HorizontalAlignment="Center" />
                <TextBlock Text="Секторы" 
                           FontSize="10" 
                           FontWeight="SemiBold"
                           Foreground="#A0FFFFFF" 
                           HorizontalAlignment="Center" 
                           Margin="0,2,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
