<ui:FluentWindow x:Class="ZenithApp.Modules.RadialSwitcher.ProgramPickerDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:ZenithApp.Modules.RadialSwitcher"
                 mc:Ignorable="d"
                 Title="Выбор программы"
                 Height="560" Width="480"
                 MinHeight="440" MinWidth="420"
                 WindowStartupLocation="CenterOwner"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 ShowInTaskbar="False"
                 ResizeMode="CanResizeWithGrip">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Заголовок окна -->
        <ui:TitleBar Grid.Row="0" 
                     Title="Выбор программы" 
                     ShowMaximize="False" 
                     ShowMinimize="False" />

        <Grid Grid.Row="1" Margin="18,6,18,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Поле поиска и кнопка обзора -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox x:Name="TxtSearch"
                            Grid.Column="0"
                            PlaceholderText="Поиск программы..." 
                            TextChanged="OnSearchTextChanged"
                            Margin="0,0,8,0" />
                <ui:Button Grid.Column="1"
                           Content="📁 Обзор..."
                           Appearance="Secondary"
                           Click="OnBrowseExeClicked" />
            </Grid>

            <!-- Список доступных программ (только название и иконка) -->
            <Border Grid.Row="1"
                    Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                    BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="4">
                <ListBox x:Name="ProgramsList"
                         SelectionMode="Single"
                         BorderThickness="0"
                         Background="Transparent"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="False"
                         PreviewMouseWheel="OnProgramsListPreviewMouseWheel"
                         MouseLeftButtonUp="OnProgramItemSelected">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:ProgramPickerItem}">
                        <Grid Margin="4,4" Background="Transparent" Cursor="Hand">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            
                            <Border Grid.Column="0" 
                                    Width="30" Height="30" 
                                    CornerRadius="6" 
                                    Background="#18FFFFFF" 
                                    Padding="2" 
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center">
                                <Image Source="{Binding Icon}" Stretch="Uniform" />
                            </Border>

                            <TextBlock Grid.Column="1" 
                                       Text="{Binding Name}" 
                                       FontWeight="SemiBold" 
                                       FontSize="13.5" 
                                       VerticalAlignment="Center" 
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Подвал -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:Button x:Name="BtnUnpin"
                       Grid.Column="0"
                       Content="❌ Открепить"
                       Appearance="Danger"
                       Click="OnUnpinClicked" />

            <ui:Button Grid.Column="2"
                       Content="Отмена"
                       Appearance="Secondary"
                       MinWidth="90"
                       Click="OnCancelClicked" />
        </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
