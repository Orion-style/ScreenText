<ui:FluentWindow x:Class="ZenithApp.Modules.RadialSwitcher.ProgramPickerDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:ZenithApp.Modules.RadialSwitcher"
                 mc:Ignorable="d"
                 Title="Закрепление программы"
                 Height="520" Width="440"
                 MinHeight="460" MinWidth="400"
                 WindowStartupLocation="CenterOwner"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 ShowInTaskbar="False"
                 ResizeMode="NoResize">

    <Grid Margin="18,10,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Заголовок окна -->
        <ui:TitleBar Grid.Row="0" 
                     Title="Закрепление программы" 
                     ShowMaximize="False" 
                     ShowMinimize="False" 
                     Margin="-18,-10,-18,8" />

        <!-- Описание и поле поиска с кнопкой обзора -->
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock x:Name="TxtDirectionHeader"
                       Text="Выберите программу для сектора" 
                       FontWeight="SemiBold" 
                       FontSize="14" 
                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" 
                       Margin="0,0,0,4" />
            <TextBlock Text="Кликните по программе из списка, чтобы закрепить её за этим сектором." 
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                       FontSize="12" 
                       Margin="0,0,0,10" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox x:Name="TxtSearch"
                            Grid.Column="0"
                            PlaceholderText="Поиск программы..." 
                            TextChanged="OnSearchTextChanged"
                            Margin="0,0,8,0" />
                <ui:Button Grid.Column="1"
                           Content="📁 Обзор (.exe)..."
                           Appearance="Secondary"
                           Click="OnBrowseExeClicked" />
            </Grid>
        </StackPanel>

        <!-- Список доступных программ -->
        <Border Grid.Row="2"
                Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="4">
            <ListBox x:Name="ProgramsList"
                     SelectionMode="Single"
                     BorderThickness="0"
                     Background="Transparent"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     MouseLeftButtonUp="OnProgramItemSelected">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:ProgramPickerItem}">
                        <Grid Margin="2,4" Background="Transparent" Cursor="Hand">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            
                            <Border Grid.Column="0" 
                                    Width="32" Height="32" 
                                    CornerRadius="6" 
                                    Background="#20FFFFFF" 
                                    Padding="3" 
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center">
                                <Image Source="{Binding Icon}" Stretch="Uniform" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" 
                                           FontWeight="SemiBold" 
                                           FontSize="13" 
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}" 
                                           FontSize="11" 
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                           TextTrimming="CharacterEllipsis" 
                                           Margin="0,1,0,0" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Подвал с кнопками -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:Button x:Name="BtnUnpin"
                       Grid.Column="0"
                       Content="❌ Открепить сектор"
                       Appearance="Danger"
                       Click="OnUnpinClicked" />

            <ui:Button Grid.Column="2"
                       Content="Отмена"
                       Appearance="Secondary"
                       Click="OnCancelClicked" />
        </Grid>
    </Grid>
</ui:FluentWindow>
