<Window x:Class="ZenithApp.Modules.Dock.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:ZenithApp.Modules.Dock"
        mc:Ignorable="d"
        Title="ZenithDock"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowActivated="False"
        Focusable="False"
        AllowDrop="True"
        DragEnter="OnWindowDragEnter"
        DragOver="OnWindowDragOver"
        Drop="OnWindowDrop">

    <Window.Resources>
        <!-- Style for ToolTip with macOS look -->
        <Style x:Key="DockToolTipStyle" TargetType="ToolTip">
            <Setter Property="Background" Value="#E61E1E1E" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="Placement" Value="Top" />
            <Setter Property="VerticalOffset" Value="-8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                BorderBrush="#40FFFFFF"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer container adding padding for magnification zoom overflow and shadows -->
    <Grid Margin="20,15,20,15">
        <!-- Floating Glass Dock Container -->
        <Border x:Name="DockPanelBorder"
                CornerRadius="20"
                Background="#C8202020"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                Padding="8,6,8,6"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom">
            
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" Direction="270" ShadowDepth="4" Opacity="0.45" Color="#000000" />
            </Border.Effect>

            <ItemsControl x:Name="ItemsHost" ItemsSource="{Binding Items}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:DockItemViewModel}">
                        <Grid x:Name="IconItemRoot" 
                              Margin="4,0,4,0" 
                              Cursor="Hand"
                              Background="Transparent"
                              MouseLeftButtonDown="OnItemLeftClick"
                              MouseRightButtonUp="OnItemRightClick"
                              MouseMove="OnItemMouseMove"
                              MouseLeave="OnItemMouseLeave"
                              ToolTipService.InitialShowDelay="150"
                              ToolTipService.ShowDuration="5000">

                            <Grid.ToolTip>
                                <ToolTip Content="{Binding Title}" Style="{StaticResource DockToolTipStyle}" />
                            </Grid.ToolTip>

                            <Grid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{Binding IsRunning, Converter={x:Null}, StringFormat='Открыть'}" Click="OnMenuOpenClick" />
                                    <MenuItem Header="Показать в папке" Click="OnMenuShowInFolderClick" />
                                    <Separator />
                                    <MenuItem Header="Закрыть" Click="OnMenuCloseGracefullyClick" />
                                    <MenuItem Header="Завершить принудительно" Click="OnMenuKillForcefullyClick" Foreground="#FF5555" />
                                    <Separator />
                                    <MenuItem Header="Убрать из дока" Click="OnMenuRemoveFromDockClick" />
                                </ContextMenu>
                            </Grid.ContextMenu>

                            <!-- Render Transform for Magnification and Launch Bounce -->
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}" CenterX="24" CenterY="48" />
                                    <TranslateTransform Y="{Binding BounceOffsetY}" />
                                </TransformGroup>
                            </Grid.RenderTransform>

                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                <!-- Main Icon with fallback if missing -->
                                <Grid Width="48" Height="48">
                                    <Image Source="{Binding Icon}" 
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           SnapsToDevicePixels="True"
                                           Stretch="Uniform" 
                                           Width="46" Height="46"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Opacity="{Binding IsMissing, Converter={x:Null}, FallbackValue=1.0}">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                        <Setter Property="Opacity" Value="0.35" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>

                                    <!-- Missing icon fallback badge -->
                                    <ui:SymbolIcon Symbol="QuestionCircle24" 
                                                   FontSize="24" 
                                                   Foreground="#FF8888" 
                                                   HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center">
                                        <ui:SymbolIcon.Style>
                                            <Style TargetType="ui:SymbolIcon">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:SymbolIcon.Style>
                                    </ui:SymbolIcon>
                                </Grid>

                                <!-- Dot indicator underneath running app -->
                                <Ellipse Width="4" Height="4" 
                                         Fill="#E6FFFFFF" 
                                         HorizontalAlignment="Center" 
                                         Margin="0,3,0,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Visibility" Value="Hidden" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </Grid>
</Window>
