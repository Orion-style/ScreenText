<UserControl x:Class="ZenithApp.Modules.Screenshot.ScreenshotSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="600">
    <StackPanel>
        <!-- Хоткей для обычного скриншота -->
        <ui:Card Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Горячая клавиша скриншота" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                        <TextBlock Text="Нажмите на поле и задайте сочетание (по умолчанию Ctrl+Shift+S)" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                   Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBox x:Name="TxtScreenshotHotkey" 
                             Grid.Column="1" 
                             MinWidth="190"
                             MaxWidth="260"
                             Padding="10,6"
                             Text="{Binding ScreenshotHotkeyText, Mode=OneWay}" 
                             IsReadOnly="True" 
                             Cursor="Hand"
                             PreviewKeyDown="OnScreenshotHotkeyKeyDown"
                             VerticalAlignment="Center"
                             TextAlignment="Center" />
                </Grid>

                <!-- Сообщение о конфликте хоткея -->
                <ui:InfoBar Title="Конфликт горячих клавиш"
                            Message="{Binding ScreenshotConflictMessage}"
                            IsOpen="{Binding HasScreenshotConflict}"
                            Severity="Error"
                            IsClosable="False"
                            Margin="0,12,0,0" />
            </StackPanel>
        </ui:Card>

        <!-- Хоткей для OCR -->
        <ui:Card Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Горячая клавиша скриншота с OCR" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                        <TextBlock Text="Копирование распознанного текста в буфер обмена (по умолчанию Ctrl+Shift+T)" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                   Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBox x:Name="TxtOcrHotkey" 
                             Grid.Column="1" 
                             MinWidth="190"
                             MaxWidth="260"
                             Padding="10,6"
                             Text="{Binding OcrHotkeyText, Mode=OneWay}" 
                             IsReadOnly="True" 
                             Cursor="Hand"
                             PreviewKeyDown="OnOcrHotkeyKeyDown"
                             VerticalAlignment="Center"
                             TextAlignment="Center" />
                </Grid>

                <!-- Сообщение о конфликте хоткея OCR -->
                <ui:InfoBar Title="Конфликт горячих клавиш"
                            Message="{Binding OcrConflictMessage}"
                            IsOpen="{Binding HasOcrConflict}"
                            Severity="Error"
                            IsClosable="False"
                            Margin="0,12,0,0" />
            </StackPanel>
        </ui:Card>

        <!-- Двухшаговый режим: 1-й вызов — выбор области, 2-й — мгновенный снимок этой области -->
        <ui:Card Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Двухшаговый режим (Выбор → Мгновенный снимок)" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                        <TextBlock Text="При первом вызове задаётся область, а при втором вызове снимок этой же области сохраняется мгновенно без повторного выделения" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                   Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" 
                                     IsChecked="{Binding TwoStepCaptureEnabled, Mode=TwoWay}" 
                                     VerticalAlignment="Center" />
                </Grid>

                <!-- Параметры двухшагового режима -->
                <StackPanel Margin="0,16,0,0" Visibility="{Binding TwoStepCaptureEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Separator Margin="0,0,0,12" Opacity="0.3" />

                    <!-- Сохранять снимок на первом шаге -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Сохранять снимок уже при первом вызове (выборе)" FontWeight="Medium" FontSize="13" TextWrapping="Wrap" />
                            <TextBlock Text="Если включено: снимок сохранится сразу при выделении + область запомнится. Если выключено: первый вызов только намечает рамку" 
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                       Margin="0,2,0,0" TextWrapping="Wrap" FontSize="12" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" 
                                         IsChecked="{Binding CaptureOnFirstCall, Mode=TwoWay}" 
                                         VerticalAlignment="Center" />
                    </Grid>

                    <!-- Сбрасывать область после второго вызова (циклический режим) -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Автосброс после второго вызова (режим цикла)" FontWeight="Medium" FontSize="13" TextWrapping="Wrap" />
                            <TextBlock Text="1-й вызов: выбор → 2-й: снимок → 3-й: снова выбор. Если выключено: область остаётся для повторных снимков подряд" 
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                       Margin="0,2,0,0" TextWrapping="Wrap" FontSize="12" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" 
                                         IsChecked="{Binding TwoStepResetAfterCapture, Mode=TwoWay}" 
                                         VerticalAlignment="Center" />
                    </Grid>

                    <!-- Статус сохранённой области и кнопка сброса -->
                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                            CornerRadius="6" 
                            Padding="12,10" 
                            Margin="0,4,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{Binding SavedAreaStatusText}" 
                                           FontWeight="Medium" 
                                           FontSize="13" 
                                           TextWrapping="Wrap" />
                                <TextBlock Text="Подсказка: зажмите клавишу Alt при нажатии хоткея, чтобы принудительно выбрать новую область." 
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                           FontSize="11" 
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                            <ui:Button Grid.Column="1" 
                                       Content="Сбросить область" 
                                       Command="{Binding ResetSavedAreaCommand}" 
                                       IsEnabled="{Binding HasSavedArea}" 
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ui:Card>

        <!-- Лупа и сетка пикселей (ShareX) -->
        <ui:Card Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Сетка пикселей и лупа (стиль ShareX)" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                        <TextBlock Text="Отображение увеличенной пиксельной сетки рядом с курсором для точного выделения. Масштаб можно регулировать колёсиком мыши или клавишами +/-." 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                   Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" 
                                     IsChecked="{Binding MagnifierEnabled, Mode=TwoWay}" 
                                     VerticalAlignment="Center" />
                </Grid>

                <!-- Параметры лупы -->
                <StackPanel Margin="0,16,0,0" Visibility="{Binding MagnifierEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Separator Margin="0,0,0,12" Opacity="0.3" />

                    <!-- Начальный масштаб увеличения -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Начальный масштаб (зум)" FontWeight="Medium" FontSize="13" TextWrapping="Wrap" />
                            <TextBlock Text="Увеличение пикселей по умолчанию (также меняется колёсиком мыши во время захвата)" 
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                       Margin="0,2,0,0" TextWrapping="Wrap" FontSize="12" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Slider Width="140" Minimum="2" Maximum="24" SmallChange="1" LargeChange="2" 
                                    Value="{Binding MagnifierZoom, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding MagnifierZoom, StringFormat='{}{0}x'}" MinWidth="40" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>

                    <!-- Размер сетки (количество пикселей) -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Размер сетки пикселей" FontWeight="Medium" FontSize="13" TextWrapping="Wrap" />
                            <TextBlock Text="Количество отображаемых пикселей вокруг курсора (например, 7×7, 11×11, 15×15)" 
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                       Margin="0,2,0,0" TextWrapping="Wrap" FontSize="12" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Slider Width="140" Minimum="5" Maximum="25" SmallChange="2" LargeChange="2" 
                                    Value="{Binding MagnifierGridSize, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding MagnifierGridSize, StringFormat='{}{0}×{0}'}" MinWidth="50" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>

                    <!-- Отображение информации о цвете и координатах -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Информация о цвете (HEX / RGB) и координаты" FontWeight="Medium" FontSize="13" TextWrapping="Wrap" />
                            <TextBlock Text="Показывать текущий цвет под курсором и точные координаты X, Y. Клавиша 'C' копирует цвет в буфер обмена." 
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                       Margin="0,2,0,0" TextWrapping="Wrap" FontSize="12" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" 
                                         IsChecked="{Binding MagnifierShowColorInfo, Mode=TwoWay}" 
                                         VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ui:Card>

        <!-- Опция сохранения скриншотов в папку -->
        <ui:Card Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Сохранять скриншоты в папку" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                        <TextBlock Text="Автоматически записывать снимок в формате PNG в выбранный каталог" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                   Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" 
                                     IsChecked="{Binding SaveToFile, Mode=TwoWay}" 
                                     VerticalAlignment="Center" />
                </Grid>

                <Grid Margin="0,12,0,0" Visibility="{Binding SaveToFile, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" 
                             Text="{Binding SaveFolderPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                             Margin="0,0,8,0"
                             VerticalAlignment="Center" />
                    <ui:Button Grid.Column="1" 
                               Content="Обзор..." 
                               Command="{Binding BrowseFolderCommand}" 
                               VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </ui:Card>
    </StackPanel>
</UserControl>
