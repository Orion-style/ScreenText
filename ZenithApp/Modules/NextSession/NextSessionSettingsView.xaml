<UserControl x:Class="ZenithApp.Modules.NextSession.NextSessionSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:ZenithApp.Modules.NextSession"
             mc:Ignorable="d"
             d:DesignHeight="520" d:DesignWidth="600">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Плитка запущенной программы (только иконка без названия) -->
        <Style x:Key="TerminationAppIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TileBorder"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                RenderTransformOrigin="0.5,0.5">
                            <Grid>
                                <Image Source="{Binding Icon}"
                                       Width="28" Height="28"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}" />
                                <ui:SymbolIcon Symbol="Apps24"
                                               FontSize="22"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasIcon}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TileBorder" Property="Background" Value="#24EF4444" />
                                <Setter TargetName="TileBorder" Property="BorderBrush" Value="#EF4444" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TileBorder" Property="Background" Value="#3AEF4444" />
                                <Setter TargetName="TileBorder" Property="BorderBrush" Value="#DC2626" />
                                <Setter TargetName="TileBorder" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.93" ScaleY="0.93" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TileBorder" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- Текущий план и быстрый вызов окна -->
        <ui:Card Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="План на следующий сеанс" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding PendingPlanSummary}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="Проверить таймер"
                               ToolTip="Показать виджет обратного отсчёта на рабочем столе (без очистки плана)"
                               Command="{Binding PreviewCountdownCommand}"
                               Margin="0,0,8,0" />
                    <ui:Button Content="Тест запуска"
                               Command="{Binding ExecuteNowCommand}"
                               IsEnabled="{Binding HasPendingPlan}"
                               Margin="0,0,8,0" />
                    <ui:Button Content="Очистить"
                               Appearance="Danger"
                               Command="{Binding ClearPlanCommand}"
                               IsEnabled="{Binding HasPendingPlan}"
                               Margin="0,0,8,0" />
                    <ui:Button Content="Открыть окно"
                               Appearance="Primary"
                               Icon="{ui:SymbolIcon WindowApps24}"
                               Command="{Binding OpenPlannerCommand}" />
                </StackPanel>
            </Grid>
        </ui:Card>

        <!-- Горячая клавиша вызова -->
        <ui:Card Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Горячая клавиша вызова окна" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                        <TextBlock Text="Нажмите на поле и задайте сочетание клавиш (по умолчанию Ctrl + Alt + N)"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBox x:Name="TxtHotkey"
                             Grid.Column="1"
                             MinWidth="190"
                             MaxWidth="260"
                             Padding="10,6"
                             Text="{Binding HotkeyText, Mode=OneWay}"
                             IsReadOnly="True"
                             Cursor="Hand"
                             PreviewKeyDown="OnHotkeyPreviewKeyDown"
                             VerticalAlignment="Center"
                             TextAlignment="Center" />
                </Grid>

                <ui:InfoBar Title="Конфликт горячих клавиш"
                            Message="{Binding ConflictMessage}"
                            IsOpen="{Binding HasConflict}"
                            Severity="Error"
                            IsClosable="False"
                            Margin="0,12,0,0" />
            </StackPanel>
        </ui:Card>

        <!-- Завершение: быстрый список программ из Alt+Tab -->
        <ui:Card Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Завершение" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                            <Border CornerRadius="6"
                                    Padding="7,2"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    Visibility="{Binding HasRunningApps, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding RunningAppsCount}"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Программы из переключателя Alt+Tab. Нажмите на иконку, чтобы завершить приложение."
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:Button Grid.Column="1"
                               Icon="{ui:SymbolIcon ArrowClockwise24}"
                               ToolTip="Обновить список открытых программ"
                               Appearance="Secondary"
                               Command="{Binding RefreshRunningAppsCommand}"
                               VerticalAlignment="Center" />
                </Grid>

                <!-- Блок с иконками без названий -->
                <Border Margin="0,12,0,12"
                        Padding="8"
                        MinHeight="72"
                        CornerRadius="8"
                        Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                        BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <Grid>
                        <ItemsControl ItemsSource="{Binding RunningApps}"
                                      Visibility="{Binding HasRunningApps, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel IsItemsHost="True" Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:RunningAppItem}">
                                    <Button Style="{StaticResource TerminationAppIconButtonStyle}"
                                            Command="{Binding DataContext.TerminateAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding IsIdle}"
                                            ToolTip="{Binding ToolTipText}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Нет открытых программ для завершения"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="12.5"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Visibility="{Binding HasNoRunningApps, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Border>

                <!-- Кнопка завершения всех программ -->
                <Grid>
                    <ui:Button Content="Завершить все"
                               Appearance="Danger"
                               Icon="{ui:SymbolIcon Dismiss20}"
                               Command="{Binding TerminateAllAppsCommand}"
                               IsEnabled="{Binding CanTerminateAll}"
                               HorizontalAlignment="Right" />
                </Grid>
            </StackPanel>
        </ui:Card>

        <!-- Задержка перед запуском после входа -->
        <ui:Card Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Пауза после запуска Windows" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                    <TextBlock Text="Задержка перед стартом выбранных программ, чтобы рабочий стол успел прогрузиться."
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Slider Width="140"
                            Minimum="0"
                            Maximum="30"
                            SmallChange="1"
                            LargeChange="5"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            Value="{Binding StartupDelaySeconds, Mode=TwoWay}"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0" />
                    <TextBlock Text="{Binding StartupDelaySeconds, StringFormat='{}{0} сек'}"
                               MinWidth="48"
                               TextAlignment="Right"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </ui:Card>
    </StackPanel>
</UserControl>
