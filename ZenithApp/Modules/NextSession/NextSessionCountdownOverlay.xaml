<Window x:Class="ZenithApp.Modules.NextSession.NextSessionCountdownOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Следующий сеанс — обратный отсчёт"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="350"
        Opacity="0">

    <Border x:Name="CardBorder"
            Margin="12"
            CornerRadius="12"
            Background="#EE1E1F24"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" Opacity="0.45" ShadowDepth="4" Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="14,12,14,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Круговой индикатор секунд -->
                <Grid Grid.Column="0"
                      Width="48" Height="48"
                      Margin="0,0,12,0"
                      VerticalAlignment="Center">
                    <Ellipse Stroke="#28FFFFFF"
                             StrokeThickness="3.5"
                             Fill="#180078D4" />
                    <Ellipse Stroke="#38BDF8"
                             StrokeThickness="3.5"
                             Opacity="0.85" />
                    <TextBlock x:Name="TxtSecondsLeft"
                               Text="10"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>

                <!-- Текст и кнопки управления -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Запуск следующего сеанса"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               Foreground="White" />

                    <TextBlock x:Name="TxtCountdownDetail"
                               Text="Подготовка рабочего стола: 10 сек"
                               FontSize="12"
                               Foreground="#CCFFFFFF"
                               Margin="0,2,0,0"
                               TextWrapping="Wrap" />

                    <TextBlock x:Name="TxtMessagePreview"
                               FontSize="11.5"
                               Foreground="#99FFFFFF"
                               Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis"
                               MaxHeight="34"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <ui:Button x:Name="BtnRunNow"
                                   Content="Запустить сейчас"
                                   Appearance="Primary"
                                   Padding="10,4"
                                   FontSize="11.5"
                                   Margin="0,0,8,0"
                                   Click="OnRunNowClicked" />
                        <ui:Button x:Name="BtnCancel"
                                   Content="Отмена"
                                   Appearance="Secondary"
                                   Padding="10,4"
                                   FontSize="11.5"
                                   Click="OnCancelClicked" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Нижняя полоса прогресса -->
            <Grid Grid.Row="1" Height="4" Background="#1FFFFFFF">
                <Border x:Name="ProgressFill"
                        HorizontalAlignment="Left"
                        Width="326"
                        Background="#38BDF8" />
            </Grid>
        </Grid>
    </Border>
</Window>
