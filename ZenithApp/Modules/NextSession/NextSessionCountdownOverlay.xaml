<Window x:Class="ZenithApp.Modules.NextSession.NextSessionCountdownOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Следующий сеанс — обратный отсчёт"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="384"
        Opacity="0">

    <Border x:Name="CardBorder"
            Margin="12"
            CornerRadius="14"
            Background="#F21A1D24"
            BorderBrush="#3AFFFFFF"
            BorderThickness="1"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Opacity="0.5" ShadowDepth="4" Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="16,14,16,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Анимированный круговой таймер -->
                <Grid Grid.Column="0"
                      Width="60" Height="60"
                      Margin="0,0,14,0"
                      VerticalAlignment="Center">
                    <Ellipse Stroke="#24FFFFFF"
                             StrokeThickness="4"
                             Fill="#1438BDF8" />
                    <Path x:Name="ProgressArcPath"
                          Stroke="#38BDF8"
                          StrokeThickness="4"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtSecondsLeft"
                                   Text="10"
                                   FontSize="19"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   LineHeight="20" />
                        <TextBlock Text="сек"
                                   FontSize="9.5"
                                   Foreground="#99FFFFFF"
                                   HorizontalAlignment="Center"
                                   Margin="0,-2,0,0" />
                    </StackPanel>
                </Grid>

                <!-- Текст, список программ и кнопки управления -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <Ellipse Width="6" Height="6"
                                 Fill="#38BDF8"
                                 VerticalAlignment="Center"
                                 Margin="0,0,6,0" />
                        <TextBlock Text="СЛЕДУЮЩИЙ СЕАНС"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#38BDF8"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock x:Name="TxtCountdownTitle"
                               Text="Запуск через 10 сек"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="White" />

                    <TextBlock x:Name="TxtProgramsSummary"
                               Text="Подготовка рабочего стола..."
                               FontSize="12"
                               Foreground="#CCFFFFFF"
                               Margin="0,2,0,0"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               MaxHeight="36" />

                    <Border x:Name="MessagePreviewBorder"
                            Margin="0,7,0,0"
                            Padding="8,5"
                            CornerRadius="6"
                            Background="#14FFFFFF"
                            BorderBrush="#38BDF8"
                            BorderThickness="2,0,0,0"
                            Visibility="Collapsed">
                        <TextBlock x:Name="TxtMessagePreview"
                                   FontSize="11.5"
                                   Foreground="#D8FFFFFF"
                                   TextTrimming="CharacterEllipsis"
                                   MaxHeight="34"
                                   TextWrapping="Wrap" />
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <ui:Button x:Name="BtnRunNow"
                                   Content="Запустить сейчас"
                                   Appearance="Primary"
                                   Padding="11,5"
                                   FontSize="11.5"
                                   Margin="0,0,8,0"
                                   Click="OnRunNowClicked" />
                        <ui:Button x:Name="BtnCancel"
                                   Content="Отмена"
                                   Appearance="Secondary"
                                   Padding="11,5"
                                   FontSize="11.5"
                                   Click="OnCancelClicked" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Нижняя полоса прогресса -->
            <Grid Grid.Row="1" Height="3.5" Background="#1FFFFFFF">
                <Border x:Name="ProgressFill"
                        HorizontalAlignment="Left"
                        Width="358"
                        Background="#38BDF8" />
            </Grid>
        </Grid>
    </Border>
</Window>
