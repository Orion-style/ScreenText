<ui:FluentWindow x:Class="ZenithApp.Modules.NextSession.NextSessionWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:ZenithApp.Modules.NextSession"
                 mc:Ignorable="d"
                 Title="Настройка следующего сеанса"
                 Height="640" Width="800"
                 MinHeight="520" MinWidth="640"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 ResizeMode="CanResizeWithGrip"
                 PreviewKeyDown="OnWindowPreviewKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Стиль плитки приложения (средняя иконка + подсветка при выборе) -->
        <Style x:Key="AppTileToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="112" />
            <Setter Property="Height" Value="104" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="RootCard"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                ClipToBounds="True">
                            <Grid>
                                <!-- Подсветка выбранной карточки -->
                                <Border x:Name="SelectedTint"
                                        Background="#38BDF8"
                                        Opacity="0" />

                                <Grid Margin="8,10,8,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Средняя иконка приложения -->
                                    <Border x:Name="IconBadge"
                                            Grid.Row="0"
                                            Width="48" Height="48"
                                            CornerRadius="10"
                                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                            BorderBrush="Transparent"
                                            BorderThickness="1.5"
                                            HorizontalAlignment="Center"
                                            Padding="5">
                                        <Grid>
                                            <Image Source="{Binding Icon}"
                                                   Width="36" Height="36"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}" />
                                            <ui:SymbolIcon Symbol="Apps24"
                                                           FontSize="26"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                <ui:SymbolIcon.Style>
                                                    <Style TargetType="ui:SymbolIcon">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasIcon}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:SymbolIcon.Style>
                                            </ui:SymbolIcon>
                                        </Grid>
                                    </Border>

                                    <!-- Название программы -->
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding Name}"
                                               FontSize="11.5"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               MaxHeight="34"
                                               Margin="0,6,0,0" />
                                </Grid>

                                <!-- Индикатор, что программа запущена сейчас -->
                                <Ellipse Width="7" Height="7"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Top"
                                         Margin="8,8,0,0"
                                         Fill="#10B981"
                                         ToolTip="Запущено сейчас"
                                         Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootCard" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter TargetName="RootCard" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="RootCard" Property="BorderBrush" Value="#38BDF8" />
                                <Setter TargetName="RootCard" Property="BorderThickness" Value="2" />
                                <Setter TargetName="SelectedTint" Property="Opacity" Value="0.16" />
                                <Setter TargetName="IconBadge" Property="Background" Value="#2E38BDF8" />
                                <Setter TargetName="IconBadge" Property="BorderBrush" Value="#38BDF8" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="SelectedTint" Property="Opacity" Value="0.24" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="Настройка следующего сеанса"
                     ShowMaximize="True"
                     ShowMinimize="False" />

        <Grid Grid.Row="1" Margin="20,6,20,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Описание и статус плана -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Выберите программы для запуска после перезагрузки и оставьте заметку — она появится в уведомлениях."
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           FontSize="13"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" />
                <Border Grid.Column="1"
                        CornerRadius="6"
                        Padding="10,4"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <TextBlock Text="{Binding PlanStatusBadgeText}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </Border>
            </Grid>

            <!-- Поле заметки для следующего сеанса -->
            <StackPanel Grid.Row="1" Margin="0,0,0,14">
                <TextBlock Text="Сообщение для следующего сеанса"
                           FontWeight="SemiBold"
                           FontSize="14"
                           Margin="0,0,0,6" />
                <ui:TextBox x:Name="TxtMessage"
                            Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Например: доделать отчёт, ответить на сообщения, проверить сборку..."
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto"
                            MinHeight="64"
                            MaxHeight="96" />
            </StackPanel>

            <!-- Панель поиска и быстрых действий для выбора программ -->
            <Grid Grid.Row="2" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:TextBox x:Name="TxtSearch"
                            Grid.Column="0"
                            PlaceholderText="Поиск программы..."
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                            Icon="{ui:SymbolIcon Search24}"
                            ClearButtonEnabled="True"
                            Margin="0,0,8,0" />

                <ui:Button Grid.Column="1"
                           Content="Выбрать открытые"
                           Icon="{ui:SymbolIcon WindowApps24}"
                           Command="{Binding SelectRunningCommand}"
                           ToolTip="Подсветить программы, которые сейчас запущены"
                           Margin="0,0,6,0" />

                <ui:Button Grid.Column="2"
                           Content="Снять выбор"
                           Command="{Binding ClearSelectionCommand}"
                           Margin="0,0,6,0" />

                <ui:Button Grid.Column="3"
                           Content="Добавить..."
                           Icon="{ui:SymbolIcon FolderOpen24}"
                           Click="OnAddCustomProgramClicked"
                           Margin="0,0,10,0" />

                <Border Grid.Column="4"
                        CornerRadius="6"
                        Padding="10,6"
                        Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedCountText}"
                               FontWeight="SemiBold"
                               FontSize="12.5"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </Border>
            </Grid>

            <!-- Сетка программ со средними иконками и подсветкой -->
            <Border Grid.Row="3"
                    Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                    BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="6">
                <Grid>
                    <ScrollViewer x:Name="ProgramsScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="OnProgramsScrollPreviewMouseWheel">
                        <ItemsControl ItemsSource="{Binding FilteredPrograms}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel IsItemsHost="True" Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:NextSessionProgramItem}">
                                    <ToggleButton IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  Style="{StaticResource AppTileToggleStyle}"
                                                  ToolTip="{Binding ToolTipText}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Индикатор загрузки каталога программ -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                        <ui:ProgressRing IsIndeterminate="True" Width="32" Height="32" Margin="0,0,0,8" />
                        <TextBlock Text="Загрузка списка программ..."
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   FontSize="13" />
                    </StackPanel>

                    <!-- Пустой результат поиска -->
                    <TextBlock Text="Программы по запросу не найдены. Используйте кнопку «Добавить...», чтобы выбрать нужный файл."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="360"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Visibility="{Binding HasNoFilteredResults, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Border>

            <!-- Нижняя панель кнопок -->
            <Grid Grid.Row="4" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:Button Grid.Column="0"
                           Content="Очистить план"
                           Appearance="Danger"
                           Command="{Binding ClearPlanCommand}" />

                <ui:Button Grid.Column="2"
                           Content="Отмена"
                           Appearance="Secondary"
                           MinWidth="88"
                           Margin="0,0,8,0"
                           Click="OnCancelClicked" />

                <ui:Button Grid.Column="3"
                           Content="Сохранить и перезагрузить"
                           Icon="{ui:SymbolIcon ArrowClockwise24}"
                           IsEnabled="{Binding CanSave}"
                           Margin="0,0,8,0"
                           Click="OnSaveAndRestartClicked" />

                <ui:Button Grid.Column="4"
                           Content="Сохранить"
                           Appearance="Primary"
                           IsEnabled="{Binding CanSave}"
                           MinWidth="115"
                           Click="OnSaveClicked" />
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
