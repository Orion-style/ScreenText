<ui:FluentWindow x:Class="ZenithApp.UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:ZenithApp.UI.ViewModels"
        xmlns:screenshot="clr-namespace:ZenithApp.Modules.Screenshot"
        xmlns:smartlinks="clr-namespace:ZenithApp.Modules.SmartLinks"
        xmlns:keyremap="clr-namespace:ZenithApp.Modules.KeyRemap"
        xmlns:quicklook="clr-namespace:ZenithApp.Modules.QuickLook"
        xmlns:snapzones="clr-namespace:ZenithApp.Modules.SnapZones"
        xmlns:radial="clr-namespace:ZenithApp.Modules.RadialSwitcher"
        mc:Ignorable="d"
        Title="{DynamicResource App_Title}"
        Icon="/Resources/app.ico"
        Height="640" Width="960"
        MinHeight="500" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Кастомный Fluent TitleBar -->
        <ui:TitleBar Grid.Row="0"
                     Title="{DynamicResource App_Title}"
                     ShowMaximize="True"
                     ShowMinimize="True" />

        <!-- Главное рабочее пространство -->
        <Grid Grid.Row="1" Margin="16,8,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Левая колонка: Меню навигации -->
            <Border Grid.Column="0" 
                    Background="{DynamicResource CardBackground}" 
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" 
                    CornerRadius="8"
                    Padding="10"
                    Margin="0,0,14,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Настройки" 
                               FontSize="18" 
                               FontWeight="SemiBold" 
                               Margin="8,4,8,12" 
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                    <!-- Пункт: Общие -->
                    <Border x:Name="BtnNavGeneral" 
                            Grid.Row="1"
                            CornerRadius="6"
                            Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                            Padding="12,10"
                            Margin="0,0,0,8"
                            Cursor="Hand"
                            MouseDown="OnGeneralNavClicked">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Settings24" Margin="0,0,10,0" FontSize="18" />
                            <TextBlock Text="{DynamicResource Nav_General}" VerticalAlignment="Center" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <!-- Заголовок секции: Модули -->
                    <TextBlock Grid.Row="2"
                               Text="Функции и модули" 
                               FontSize="12" 
                               FontWeight="SemiBold" 
                               Margin="8,6,8,6" 
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                    <!-- Список модулей -->
                    <ListBox x:Name="ModulesList"
                             Grid.Row="3"
                             ItemsSource="{Binding Modules}"
                             SelectionMode="Single"
                             BorderThickness="0"
                             Background="Transparent"
                             SelectionChanged="OnModuleSelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10,8" />
                                <Setter Property="Margin" Value="0,2" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder"
                                                    CornerRadius="6"
                                                    Background="Transparent"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ModuleItemViewModel}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ui:SymbolIcon Symbol="Apps24" Grid.Column="0" Margin="0,0,8,0" FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    
                                    <TextBlock Grid.Column="1" 
                                               Text="{Binding Name}" 
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               FontSize="13" />

                                    <!-- Индикатор активности модуля -->
                                    <Ellipse Grid.Column="2" 
                                             Width="7" Height="7" 
                                             Margin="6,0,2,0" 
                                             VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="Transparent" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource SystemAccentColorLight1Brush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Правая колонка: Контент страниц -->
            <Border Grid.Column="1" 
                    Background="{DynamicResource CardBackground}" 
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" 
                    CornerRadius="8"
                    Padding="28,24">
                <Grid>
                    <!-- Страница 1: Общие -->
                    <ScrollViewer x:Name="GeneralPage" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource General_Header}" 
                                       FontSize="22" 
                                       FontWeight="Bold" 
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                       Margin="0,0,0,18" />

                            <!-- Автозапуск -->
                            <ui:Card Padding="16" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource General_Startup_Title}" FontWeight="SemiBold" FontSize="15" />
                                        <TextBlock Text="{DynamicResource General_Startup_Desc}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="1" 
                                                     IsChecked="{Binding StartWithWindows, Mode=TwoWay}" 
                                                     VerticalAlignment="Center" />
                                </Grid>
                            </ui:Card>

                            <!-- Выбор темы -->
                            <ui:Card Padding="16" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource General_Theme_Title}" FontWeight="SemiBold" FontSize="15" />
                                        <TextBlock Text="{DynamicResource General_Theme_Desc}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" 
                                              SelectedIndex="{Binding SelectedThemeIndex, Mode=TwoWay}" 
                                              Width="160"
                                              VerticalAlignment="Center">
                                        <ComboBoxItem Content="{DynamicResource Theme_System}" />
                                        <ComboBoxItem Content="{DynamicResource Theme_Light}" />
                                        <ComboBoxItem Content="{DynamicResource Theme_Dark}" />
                                    </ComboBox>
                                </Grid>
                            </ui:Card>

                            <!-- Папка настроек -->
                            <ui:Card Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource General_Data_Title}" FontWeight="SemiBold" FontSize="15" />
                                        <TextBlock Text="{DynamicResource General_Data_Desc}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ui:Button Grid.Column="1" 
                                               Content="{DynamicResource General_Btn_OpenFolder}" 
                                               Icon="{ui:SymbolIcon Folder24}" 
                                               Command="{Binding OpenSettingsFolderCommand}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </ui:Card>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Страница 2: Детализация выбранного модуля -->
                    <ScrollViewer x:Name="ModuleDetailPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel x:Name="SelectedModulePanel">
                            <TextBlock x:Name="TxtModuleName" 
                                       FontSize="22" 
                                       FontWeight="Bold" 
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            
                            <TextBlock x:Name="TxtModuleDesc" 
                                       FontSize="14" 
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                       TextWrapping="Wrap" 
                                       Margin="0,6,0,20" />

                            <!-- Переключатель активации -->
                            <ui:Card Padding="16" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Module_EnableToggle}" FontWeight="SemiBold" FontSize="15" />
                                        <TextBlock x:Name="TxtModuleStatus" 
                                                   Text="{DynamicResource Module_StatusInactive}" 
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                    <ui:ToggleSwitch x:Name="SwitchModuleState" 
                                                     Grid.Column="1" 
                                                     VerticalAlignment="Center"
                                                     Click="OnModuleToggleClicked" />
                                </Grid>
                            </ui:Card>

                            <!-- Настройки модуля Screenshot -->
                            <ContentControl x:Name="ScreenshotConfigContainer" 
                                            Visibility="Collapsed"
                                            Margin="0,0,0,16">
                                <screenshot:ScreenshotSettingsView DataContext="{Binding ScreenshotSettings}" />
                            </ContentControl>

                            <!-- Настройки модуля SmartLinks -->
                            <ContentControl x:Name="SmartLinksConfigContainer" 
                                            Visibility="Collapsed"
                                            Margin="0,0,0,16">
                                <smartlinks:SmartLinksSettingsView DataContext="{Binding SmartLinksSettings}" />
                            </ContentControl>

                            <!-- Настройки модуля KeyRemap -->
                            <ContentControl x:Name="KeyRemapConfigContainer" 
                                            Visibility="Collapsed"
                                            Margin="0,0,0,16">
                                <keyremap:KeyRemapSettingsView DataContext="{Binding KeyRemapSettings}" />
                            </ContentControl>

                            <!-- Настройки модуля QuickLook -->
                            <ContentControl x:Name="QuickLookConfigContainer" 
                                            Visibility="Collapsed"
                                            Margin="0,0,0,16">
                                <quicklook:QuickLookSettingsView DataContext="{Binding QuickLookSettings}" />
                            </ContentControl>

                            <!-- Настройки модуля SnapZones -->
                            <ContentControl x:Name="SnapZonesConfigContainer" 
                                            Visibility="Collapsed"
                                            Margin="0,0,0,16">
                                <snapzones:SnapZonesSettingsView DataContext="{Binding SnapZonesSettings}" />
                            </ContentControl>

                            <!-- Настройки модуля RadialSwitcher -->
                            <ContentControl x:Name="RadialSwitcherConfigContainer" 
                                            Visibility="Collapsed"
                                            Margin="0,0,0,16">
                                <radial:RadialSwitcherSettingsView DataContext="{Binding RadialSwitcherSettings}" />
                            </ContentControl>

                            <!-- Плейсхолдер под дальнейшие настройки остальных модулей -->
                            <ui:Card x:Name="CardConfigPlaceholder" Padding="24">
                                <StackPanel HorizontalAlignment="Center" Margin="16">
                                    <ui:SymbolIcon Symbol="Wrench24" FontSize="36" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,12" />
                                    <TextBlock Text="{DynamicResource Module_ConfigPlaceholder}" 
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                               HorizontalAlignment="Center" 
                                               TextAlignment="Center" />
                                </StackPanel>
                            </ui:Card>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
